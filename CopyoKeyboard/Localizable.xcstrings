            "state": "translated",
            "value": "Ouvre Copymunk et enregistre le contenu actuel du presse-papiers."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka Copymunk dan menyimpan apa pun yang ada di papan klip saat ini."
          }
        },
        "it": {
