    "Copymunk can't open its library right now.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتعذّر على Copymunk فتح مكتبته حاليًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk kann seine Bibliothek gerade nicht öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk can't open its library right now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk no puede abrir su biblioteca en este momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk ne peut pas ouvrir sa bibliothèque pour le moment."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunkは現在ライブラリを開けません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk 暂时打不开自己的资料库。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk 目前無法打開資料庫。"
          }
        }
      }
    },
    "Copymunk couldn't read that image.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على Copymunk قراءة تلك الصورة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk konnte dieses Bild nicht lesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk couldn't read that image."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk no ha podido leer esa imagen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk n’a pas pu lire cette image."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunkはその画像を読み取れませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk 读不出这张图片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk 無法讀取該影像。"
          }
        }
      }
    },
    "Copymunk couldn't read what you shared.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على Copymunk قراءة ما شاركته."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk konnte nicht lesen, was du geteilt hast."
