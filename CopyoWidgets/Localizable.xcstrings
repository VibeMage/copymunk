    "Copymunk can't open its library right now.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتعذّر على Copymunk فتح مكتبته حاليًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk kann seine Bibliothek gerade nicht öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk can't open its library right now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk no puede abrir su biblioteca en este momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk ne peut pas ouvrir sa bibliothèque pour le moment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk non riesce ad aprire la sua libreria in questo momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunkは現在ライブラリを開けません。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk şu anda kendi arşivini açamıyor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk hiện không thể mở thư viện của mình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk 暂时打不开自己的资料库。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk 目前無法打開資料庫。"
          }
        }
      }
    },
    "Copymunk couldn't read that image.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
