    "The clips you copied most recently. Tap one to copy it again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العناصر التي نسختها مؤخرًا. اضغط أحدها لنسخه مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die zuletzt kopierten Einträge. Tippe auf einen, um ihn erneut zu kopieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The clips you copied most recently. Tap one to copy it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los elementos que has copiado recientemente. Toca uno para volver a copiarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les éléments que vous avez copiés récemment. Touchez-en un pour le copier à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli elementi che hai copiato di recente. Toccane uno per copiarlo di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近コピーした項目です。タップすると、もう一度コピーできます。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En son kopyaladığınız öğeler. Yeniden kopyalamak için birine dokunun."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các mục bạn đã sao chép gần đây nhất. Chạm vào một mục để sao chép lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近复制过的内容。点一下就能再复制一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你最近拷貝過的項目。點一下即可再次拷貝。"
          }
        }
      }
    },
