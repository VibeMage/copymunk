{
  "sourceLanguage": "en",
  "strings": {
    "Save my clipboard to ${applicationName}": {
      "localizations": {
        "zh-Hans": {
          "stringSet": {
            "state": "translated",
            "values": [
              "保存剪贴板到 ${applicationName}",
              "用 ${applicationName} 保存剪贴板"
            ]
          }
        },
        "fr": {
          "stringSet": {
            "state": "translated",
            "values": [
              "Enregistrer mon presse-papiers dans ${applicationName}"
            ]
          }
        },
        "de": {
          "stringSet": {
            "state": "translated",
            "values": [
