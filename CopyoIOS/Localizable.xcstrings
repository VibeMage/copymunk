    "Not there yet? Copy something in another app, come back to Copymunk once, then look again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يظهر بعد؟ انسخ شيئًا في تطبيق آخر، وعُد إلى Copymunk مرة واحدة، ثم ابحث مجددًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nicht da? Kopiere etwas in einer anderen App, kehre einmal zu Copymunk zurück und sieh dann erneut nach."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not there yet? Copy something in another app, come back to Copymunk once, then look again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿No aparece? Copia algo en otra app, vuelve una vez a Copymunk y mira de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Option absente ? Copiez quelque chose dans une autre app, revenez une fois dans Copymunk, puis regardez à nouveau."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum muncul? Salin sesuatu di app lain, kembali ke Copymunk sekali, lalu periksa lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non c’è ancora? Copia qualcosa in un’altra app, torna una volta su Copymunk e poi guarda di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見つからない場合は、ほかのアプリで何かをコピーし、一度Copymunkに戻ってから、もう一度確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목이 아직 보이지 않으면 다른 앱에서 무언가를 복사하고 Copymunk로 한 번 돌아온 다음 다시 확인하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Staat het er nog niet? Kopieer iets in een andere app, ga één keer terug naar Copymunk en kijk dan opnieuw."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пункта нет? Скопируйте что-нибудь в другом приложении, один раз вернитесь в Copymunk и посмотрите снова."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่เห็นใช่ไหม ลองคัดลอกบางอย่างในแอปอื่น กลับมาที่ Copymunk หนึ่งครั้ง แล้วดูอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz görünmüyor mu? Başka bir uygulamada bir şey kopyalayın, bir kez Copymunk’a dönün ve yeniden bakın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa thấy tùy chọn này? Hãy sao chép nội dung nào đó trong ứng dụng khác, quay lại Copymunk một lần, rồi xem lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到这一项？先在别的 App 里复制点内容，回 Copymunk 一次再来看。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到這個選項？先在其他 App 中拷貝一些內容，回到 Copymunk 一次，再回來看看。"
          }
        }
      }
    },
