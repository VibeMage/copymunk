    "File contents stay on your Mac. Copymunk keeps the name so you can find it there.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبقى محتوى الملف على Mac. يحتفظ Copymunk بالاسم لتتمكن من العثور عليه هناك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateiinhalte bleiben auf deinem Mac. Copymunk behält den Namen, damit du die Datei dort wiederfindest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File contents stay on your Mac. Copymunk keeps the name so you can find it there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contenido de los archivos se queda en tu Mac. Copymunk guarda el nombre para que puedas encontrarlo allí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contenu des fichiers reste sur votre Mac. Copymunk en conserve le nom pour que vous puissiez le retrouver."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Isi file tetap ada di Mac Anda. Copymunk menyimpan namanya agar Anda dapat menemukannya di sana."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il contenuto dei file resta sul Mac. Copymunk ne conserva il nome, così puoi ritrovarli lì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルの内容はMacにのみ保存されています。Macで見つけられるように、Copymunkはファイル名を残しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 내용은 Mac에만 있습니다. Mac에서 찾을 수 있도록 Copymunk가 파일 이름을 보관합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De inhoud van bestanden blijft op je Mac. Copymunk bewaart de naam, zodat je het bestand daar kunt terugvinden."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Содержимое файлов остается на Mac. Copymunk сохраняет имя, чтобы Вы могли найти файл там."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เนื้อหาไฟล์อยู่บน Mac ของคุณ Copymunk เก็บชื่อไฟล์ไว้ให้คุณไปหาบน Mac ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya içeriği Mac’inizde kalır. Orada bulabilmeniz için Copymunk dosyanın adını saklar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nội dung tệp vẫn ở trên Mac của bạn. Copymunk giữ lại tên tệp để bạn có thể tìm thấy tệp ở đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件内容只在 Mac 上可用，这里保留文件名，方便你回到 Mac 上找。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案內容只保留在 Mac 上，這裡保留檔案名稱，方便你回到 Mac 上找到它。"
          }
        }
      }
    },
