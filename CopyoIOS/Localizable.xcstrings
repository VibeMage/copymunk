    "When you open Copymunk": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند فتح Copymunk"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Öffnen von Copymunk"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you open Copymunk"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al abrir Copymunk"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À l’ouverture de Copymunk"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando apri Copymunk"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunkを開いたとき"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk를 열 때"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk’u açtığınızda"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi bạn mở Copymunk"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Copymunk 时"
          }
        },
        "zh-Hant": {
