        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个控件由 Copymunk 自带，不需要先添加任何东西。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個控制項目是 Copymunk 內建的，不需要先加入任何東西。"
          }
        }
      }
    },
    "The keyboard extension needs it to read your history. The Copymunk keyboard never goes online, and never records what you type.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج إليه امتداد لوحة المفاتيح لقراءة سجلك. لا تتصل لوحة مفاتيح Copymunk بالإنترنت أبدًا، ولا تسجّل ما تكتبه أبدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tastaturerweiterung braucht ihn, um deinen Verlauf zu lesen. Die Copymunk-Tastatur geht nie online und zeichnet nie auf, was du tippst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The keyboard extension needs it to read your history. The Copymunk keyboard never goes online, and never records what you type."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La extensión de teclado lo necesita para leer tu historial. El teclado Copymunk nunca se conecta a internet ni registra lo que escribes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’extension de clavier en a besoin pour lire votre historique. Le clavier Copymunk ne se connecte jamais à Internet et n’enregistre jamais ce que vous tapez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekstensi papan ketik memerlukannya untuk membaca riwayat Anda. Papan ketik Copymunk tidak pernah terhubung ke internet dan tidak pernah mencatat apa yang Anda ketik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’estensione tastiera ne ha bisogno per leggere la cronologia. La tastiera Copymunk non si connette mai a internet e non registra mai ciò che scrivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボード機能拡張が履歴を読み取るために必要です。Copymunkキーボードがインターネットに接続したり、入力内容を記録したりすることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드 확장 프로그램이 기록을 읽으려면 이 권한이 필요합니다. Copymunk 키보드는 인터넷에 연결하지 않으며 입력한 내용을 기록하지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De toetsenbordextensie heeft dit nodig om je geschiedenis te lezen. Het Copymunk-toetsenbord gaat nooit online en legt nooit vast wat je typt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он нужен расширению клавиатуры, чтобы читать историю. Клавиатура Copymunk никогда не выходит в интернет и не записывает то, что Вы вводите."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่วนขยายแป้นพิมพ์ต้องใช้สิทธิ์นี้เพื่ออ่านประวัติของคุณ แป้นพิมพ์ Copymunk ไม่เชื่อมต่ออินเทอร์เน็ตและไม่บันทึกสิ่งที่คุณพิมพ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klavye uzantısının geçmişinizi okuyabilmesi için bu gereklidir. Copymunk klavyesi asla internete bağlanmaz ve yazdıklarınızı asla kaydetmez."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phần mở rộng bàn phím cần quyền này để đọc lịch sử của bạn. Bàn phím Copymunk không bao giờ kết nối mạng và không bao giờ ghi lại những gì bạn nhập."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "键盘扩展需要它才能读取历史。Copymunk 键盘不联网，也不记录你的输入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鍵盤延伸功能需要此權限才能讀取歷史記錄。Copymunk 鍵盤永遠不會連網，也不會記錄你輸入的內容。"
          }
        }
      }
    },
    "There's nothing to save here.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد هنا شيء لحفظه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier gibt es nichts zu sichern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There's nothing to save here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí no hay nada que guardar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n’y a rien à enregistrer ici."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada yang dapat disimpan di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui non c’è niente da salvare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここには保存できるものがありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기에는 저장할 항목이 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is hier niets om te bewaren."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь нечего сохранять."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีสิ่งที่จะบันทึกที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Burada kaydedilecek bir şey yok."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có gì để lưu ở đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里没有可保存的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這裡沒有可儲存的內容。"
          }
        }
      }
    },
    "This build is not signed for iCloud sync": {
