    "Open Control Center and press and hold an empty spot": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح مركز التحكم والمس مطولًا مكانًا فارغًا"
          }
        },
        "de": {
