    "File contents stay on your Mac. Copymunk keeps the name so you can find it there.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبقى محتوى الملف على Mac. يحتفظ Copymunk بالاسم لتتمكن من العثور عليه هناك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateiinhalte bleiben auf deinem Mac. Copymunk behält den Namen, damit du die Datei dort wiederfindest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File contents stay on your Mac. Copymunk keeps the name so you can find it there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contenido de los archivos se queda en tu Mac. Copymunk guarda el nombre para que puedas encontrarlo allí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contenu des fichiers reste sur votre Mac. Copymunk en conserve le nom pour que vous puissiez le retrouver."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il contenuto dei file resta sul Mac. Copymunk ne conserva il nome, così puoi ritrovarli lì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルの内容はMacにのみ保存されています。Macで見つけられるように、Copymunkはファイル名を残しています。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya içeriği Mac’inizde kalır. Orada bulabilmeniz için Copymunk dosyanın adını saklar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件内容只在 Mac 上可用，这里保留文件名，方便你回到 Mac 上找。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
