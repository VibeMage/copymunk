      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السماح باللصق من تطبيقات أخرى"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus anderen Apps einsetzen"
          }
        },
        "en": {
