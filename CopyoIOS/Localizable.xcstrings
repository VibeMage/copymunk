    "Tired of tapping Allow Paste?": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل سئمت الضغط على «السماح باللصق»؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Lust mehr, auf „Einsetzen erlauben“ zu tippen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tired of tapping Allow Paste?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿No quieres tocar “Permitir pegar” cada vez?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marre de toucher « Autoriser le collage » ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bosan mengetuk Izinkan Tempel?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non vuoi più toccare “Consenti” ogni volta?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎回「ペーストを許可」をタップするのが面倒ですか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘붙여넣기 허용’을 매번 탭하기 번거롭다면"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen zin om steeds op ‘Sta plakken toe’ te tikken?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Надоело касаться «Разрешить вставку»?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เบื่อที่ต้องแตะ “อนุญาตให้วาง” ทุกครั้งใช่ไหม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sürekli “Yapıştırmaya İzin Ver”e dokunmaktan sıkıldınız mı?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không muốn lần nào cũng phải chạm vào “Cho phép dán”?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不想每次都点「允许粘贴」？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不想每次都點「允許貼上」？"
          }
        }
      }
    },
