    "It syncs to the Pinboard tab on your Mac.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتم مزامنته مع علامة تبويب Pinboard على Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wird mit dem Pinboard-Tab auf deinem Mac synchronisiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It syncs to the Pinboard tab on your Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se sincroniza con la pestaña Pinboard de tu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il se synchronise avec l’onglet Pinboard de votre Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Viene sincronizzato con il pannello Pinboard del Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MacのPinboardタブに同期されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac의 Pinboard 탭에 동기화됩니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac’inizdeki Pinboard sekmesiyle eşzamanlanır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinboard sẽ được đồng bộ hóa với tab Pinboard trên Mac của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会同步到 Mac 上的 Pinboard 标签"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "會同步到 Mac 上的 Pinboard 標籤頁。"
          }
        }
      }
    },
    "It syncs to the Pinboard tags on your Mac.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
