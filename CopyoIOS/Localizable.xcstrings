    "Your verification code is 482913. It expires in 5 minutes.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رمز التحقق الخاص بك هو 482913. تنتهي صلاحيته خلال 5 دقائق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Bestätigungscode lautet 482913. Er läuft in 5 Minuten ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your verification code is 482913. It expires in 5 minutes."
          }
        },
        "es": {
