    "One press saves whatever is on the clipboard right now. Copymunk opens and shows “Saved”.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضغطة واحدة تحفظ كل ما في الحافظة الآن. يُفتح Copymunk ويعرض «تم الحفظ»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Tastendruck sichert, was gerade in der Zwischenablage ist. Copymunk öffnet sich und zeigt „Gesichert“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One press saves whatever is on the clipboard right now. Copymunk opens and shows “Saved”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sola pulsación guarda lo que haya ahora en el portapapeles. Copymunk se abre y muestra “Guardado”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une seule pression enregistre le contenu actuel du presse-papiers. Copymunk s’ouvre et affiche « Enregistré »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con una sola pressione salvi ciò che c’è negli appunti in quel momento. Copymunk si apre e mostra “Salvato”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワンタッチで、いまクリップボードにある内容を保存します。Copymunkが開いて「保存しました」と表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번 누르면 지금 클립보드에 있는 내용이 저장됩니다. Copymunk가 열리고 ‘저장됨’이 표시됩니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek basışla panoda o anda ne varsa kaydedilir. Copymunk açılır ve “Kaydedildi” mesajını gösterir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ một lần nhấn là lưu mọi thứ đang có trong bảng nhớ tạm. Copymunk sẽ mở và hiển thị “Đã lưu”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按一下就把当前剪贴板存进 Copymunk。系统会打开 Copymunk 并显示「已保存」。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按一下就能儲存目前剪貼板上的內容。Copymunk 會打開並顯示「已儲存」。"
          }
        }
      }
    },
