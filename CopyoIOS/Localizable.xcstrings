    "Sign in to iCloud to sync with your Mac": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل الدخول إلى iCloud للمزامنة مع Mac"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich bei iCloud an, um mit deinem Mac zu synchronisieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to iCloud to sync with your Mac"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión en iCloud para sincronizar con tu Mac"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous à iCloud pour synchroniser avec votre Mac"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masuk ke iCloud untuk menyelaraskan dengan Mac Anda"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi a iCloud per sincronizzare con il Mac"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macと同期するにはiCloudにサインインしてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac과 동기화하려면 iCloud에 로그인하십시오"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Log in bij iCloud om met je Mac te synchroniseren"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите в iCloud для синхронизации с Mac"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลงชื่อเข้า iCloud เพื่อเชื่อมข้อมูลกับ Mac ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac’inizle eşzamanlamak için iCloud’da oturum açın"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập iCloud để đồng bộ hóa với Mac"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录 iCloud 才能与 Mac 同步"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入 iCloud 才能與 Mac 同步"
          }
        }
      }
    },
    "Sign in to the same Apple Account on your Mac and iPad. Your clips travel through iCloud only, never through a third-party server.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل الدخول إلى حساب Apple نفسه على Mac وiPad. تنتقل عناصرك عبر iCloud فقط، ولا تمر أبدًا عبر خادم جهة خارجية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich auf deinem Mac und deinem iPad mit demselben Apple Account an. Deine Einträge laufen nur über iCloud, nie über den Server eines Drittanbieters."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to the same Apple Account on your Mac and iPad. Your clips travel through iCloud only, never through a third-party server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión con la misma Cuenta de Apple en tu Mac y en tu iPad. Tus elementos viajan solo a través de iCloud, nunca por un servidor de terceros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous au même compte Apple sur votre Mac et votre iPad. Vos éléments passent uniquement par iCloud, jamais par un serveur tiers."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masuk ke Akun Apple yang sama di Mac dan iPad Anda. Item Anda hanya melewati iCloud, tidak pernah melalui server pihak ketiga."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi con lo stesso Apple Account su Mac e iPad. I tuoi elementi passano solo da iCloud, mai da server di terze parti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MacとiPadで同じApple Accountにサインインしてください。項目はiCloudだけを経由し、他社のサーバを経由することはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac과 iPad에서 같은 Apple 계정으로 로그인하십시오. 항목은 타사 서버를 거치지 않고 iCloud를 통해서만 전달됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Log op je Mac en iPad in met hetzelfde Apple Account. Je items gaan alleen via iCloud, nooit via een server van derden."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите в один и тот же Аккаунт Apple на Mac и iPad. Ваши элементы передаются только через iCloud и никогда — через сторонние серверы."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลงชื่อเข้าบัญชี Apple เดียวกันบน Mac และ iPad รายการของคุณจะส่งผ่าน iCloud เท่านั้น ไม่ผ่านเซิร์ฟเวอร์ของบุคคลที่สามใดๆ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac’inizde ve iPad’inizde aynı Apple Hesabı ile oturum açın. Öğeleriniz yalnızca iCloud üzerinden aktarılır, asla üçüncü taraf bir sunucudan geçmez."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập cùng một Tài khoản Apple trên Mac và iPad. Các mục của bạn chỉ đi qua iCloud, không bao giờ qua máy chủ bên thứ ba."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 与 iPad 登录同一 Apple 账户即可。内容只经过 iCloud，不经过任何第三方服务器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Mac 和 iPad 上登入同一個 Apple 帳號即可。你的內容只會經由 iCloud 傳送，絕不經過任何第三方伺服器。"
          }
        }
      }
    },
