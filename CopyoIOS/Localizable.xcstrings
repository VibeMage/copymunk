    "It syncs to the Pinboard tab on your Mac.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتم مزامنته مع علامة تبويب Pinboard على Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wird mit dem Pinboard-Tab auf deinem Mac synchronisiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It syncs to the Pinboard tab on your Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se sincroniza con la pestaña Pinboard de tu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il se synchronise avec l’onglet Pinboard de votre Mac."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinboard ini diselaraskan ke tab Pinboard di Mac Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Viene sincronizzato con il pannello Pinboard del Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MacのPinboardタブに同期されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac의 Pinboard 탭에 동기화됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het wordt gesynchroniseerd met het Pinboard-tabblad op je Mac."
          }
        },
