    "Give Save Content some text, a link, or an image.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعطِ «حفظ المحتوى» نصًا أو رابطًا أو صورة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib „Inhalt sichern“ einen Text, einen Link oder ein Bild."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give Save Content some text, a link, or an image."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dale a “Guardar contenido” un texto, un enlace o una imagen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Enregistrer le contenu » a besoin d’un texte, d’un lien ou d’une image."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "“Simpan Konten” memerlukan teks, tautan, atau gambar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fornisci a “Salva contenuto” un testo, un link o un’immagine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「コンテンツを保存」には、テキスト、リンク、画像のいずれかを指定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘콘텐츠 저장’에 텍스트, 링크 또는 이미지를 지정하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef ‘Bewaar inhoud’ wat tekst, een link of een afbeelding."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Передайте действию «Сохранить содержимое» текст, ссылку или изображение."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โปรดใส่ข้อความ ลิงก์ หรือภาพให้กับ “บันทึกเนื้อหา”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“İçeriği Kaydet” eylemine bir metin, bağlantı veya görüntü verin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "“Lưu nội dung” cần có văn bản, liên kết hoặc hình ảnh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「保存内容」至少要给一段文本、一个链接或一张图片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「儲存內容」至少需要一段文字、一個連結或一張影像。"
          }
        }
      }
    },
    "Go to Settings": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
