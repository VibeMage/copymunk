    },
    "It will be removed from Copymunk on all your devices.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستتم إزالته من Copymunk على كل أجهزتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wird auf allen deinen Geräten aus Copymunk entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It will be removed from Copymunk on all your devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminará de Copymunk en todos tus dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il sera supprimé de Copymunk sur tous vos appareils."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrà rimosso da Copymunk su tutti i tuoi dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのデバイスのCopymunkから削除されます。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm aygıtlarınızdaki Copymunk’tan kaldırılacak."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会从你所有设备上的 Copymunk 中移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將從你所有裝置上的 Copymunk 中移除。"
          }
        }
      }
    },
    "Its clips go back to History and are not deleted.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعود عناصره إلى السجل ولا تُحذف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seine Einträge kehren in den Verlauf zurück und werden nicht gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its clips go back to History and are not deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus elementos vuelven al historial y no se eliminan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses éléments retournent dans l’historique et ne sont pas supprimés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I suoi elementi tornano nella cronologia e non vengono eliminati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中の項目は履歴に戻り、削除はされません。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçindeki öğeler Geçmiş’e döner ve silinmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "板里的条目会回到历史，不会被删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其中的項目會回到歷史記錄，不會被刪除。"
          }
        }
      }
    },
