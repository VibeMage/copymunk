    "Select text or an image in any app, tap Share, then tap “Copymunk”. You can pick a Pinboard on the way in.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدد نصًا أو صورة في أي تطبيق، واضغط «مشاركة»، ثم اضغط «Copymunk». يمكنك اختيار Pinboard أثناء ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markiere Text oder ein Bild in einer beliebigen App, tippe auf „Teilen“ und dann auf „Copymunk“. Dabei kannst du gleich ein Pinboard wählen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select text or an image in any app, tap Share, then tap “Copymunk”. You can pick a Pinboard on the way in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona texto o una imagen en cualquier app, toca “Compartir” y luego “Copymunk”. Puedes elegir un Pinboard sobre la marcha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez du texte ou une image dans n’importe quelle app, touchez « Partager », puis « Copymunk ». Vous pouvez choisir un Pinboard au passage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona del testo o un’immagine in qualsiasi app, tocca “Condividi”, poi tocca “Copymunk”. Puoi anche scegliere subito un Pinboard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意のアプリでテキストや画像を選択し、「共有」をタップしてから「Copymunk」をタップします。その際にPinboardも選べます。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Herhangi bir uygulamada metin veya görüntü seçin, “Paylaş”a, ardından “Copymunk”a dokunun. Kaydederken bir Pinboard da seçebilirsiniz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在任何 App 里选中文字或图片，点「分享」，再点「Copymunk」。可以顺手选 Pinboard。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在任何 App 中選取文字或影像，點一下「分享」，再點一下「Copymunk」。存入時還可以順便選擇 Pinboard。"
          }
        }
      }
    },
