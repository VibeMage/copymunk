    "Pinboards are shared with your Mac. Swiping a card right pins it to the first pinboard; long-press to pick another.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتم مشاركة لوحات Pinboard مع Mac. سحب بطاقة إلى اليسار يثبّتها في أول Pinboard؛ المسها مطولًا لاختيار غيره."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinboards werden mit deinem Mac geteilt. Streichst du eine Karte nach rechts, wird sie am ersten Pinboard angeheftet; drücke lange, um ein anderes zu wählen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinboards are shared with your Mac. Swiping a card right pins it to the first pinboard; long-press to pick another."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los Pinboards se comparten con tu Mac. Al deslizar una tarjeta a la derecha, se fija en el primer Pinboard; mantenla pulsada para elegir otro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les Pinboards sont partagés avec votre Mac. Balayez une carte vers la droite pour l’épingler au premier Pinboard ; appui long pour en choisir un autre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I Pinboard sono condivisi con il Mac. Se scorri una scheda verso destra, viene fissata nel primo Pinboard; tieni premuto per sceglierne un altro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PinboardはMacと共有されます。カードを右にスワイプすると最初のPinboardにピン留めされ、長押しするとほかのPinboardを選べます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinboard는 Mac과 공유됩니다. 카드를 오른쪽으로 쓸어넘기면 첫 번째 Pinboard에 고정되며, 길게 눌러 다른 Pinboard를 선택할 수 있습니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinboard’lar Mac’inizle paylaşılır. Bir kartı sağa kaydırdığınızda kart ilk Pinboard’a iğnelenir; başka birini seçmek için kartı basılı tutun."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinboard được dùng chung với Mac của bạn. Vuốt sang phải trên một thẻ để ghim vào Pinboard đầu tiên; chạm và giữ để chọn Pinboard khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinboard 与 Mac 共用同一份。右滑固定卡片时默认进入第一个 Pinboard，长按可选。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinboard 與 Mac 共用。向右滑動卡片會釘選到第一個 Pinboard；按住卡片可選擇其他 Pinboard。"
          }
        }
      }
    },
