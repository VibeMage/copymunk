    "Opens Copymunk and saves whatever is on the clipboard right now.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح Copymunk ويحفظ كل ما في الحافظة الآن."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet Copymunk und sichert, was gerade in der Zwischenablage ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens Copymunk and saves whatever is on the clipboard right now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Copymunk y guarda lo que haya ahora en el portapapeles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Copymunk et enregistre le contenu actuel du presse-papiers."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka Copymunk dan menyimpan apa pun yang ada di papan klip saat ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre Copymunk e salva ciò che c’è negli appunti in quel momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunkを開き、いまクリップボードにある内容を保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk를 열고 지금 클립보드에 있는 내용을 저장합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent Copymunk en bewaart wat er op dit moment op het klembord staat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает Copymunk и сохраняет текущее содержимое буфера обмена."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด Copymunk และบันทึกสิ่งที่อยู่ในคลิปบอร์ดตอนนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk’u açar ve panoda o anda ne varsa kaydeder."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở Copymunk và lưu mọi thứ đang có trong bảng nhớ tạm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Copymunk，把此刻剪贴板里的内容存下来。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開 Copymunk 並儲存目前剪貼板上的內容。"
          }
        }
      }
    },
