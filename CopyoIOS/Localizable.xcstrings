    "Pin a clip to keep it out of the history limit.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ثبّت عنصرًا لاستثنائه من حد السجل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hefte einen Eintrag an, damit er nicht unter das Verlaufslimit fällt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pin a clip to keep it out of the history limit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fija un elemento para que no cuente en el límite del historial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Épinglez un élément pour l’exclure de la limite de l’historique."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pin item agar tidak terkena batas riwayat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fissa un elemento per escluderlo dal limite della cronologia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピン留めした項目は履歴の上限の対象外になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목을 고정하면 기록 한도의 영향을 받지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak een item vast om het buiten de geschiedenislimiet te houden."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрепите элемент, чтобы на него не распространялся лимит истории."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปักหมุดรายการเพื่อไม่ให้นับรวมในขีดจำกัดประวัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir öğeyi geçmiş sınırının dışında tutmak için iğneleyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghim một mục để mục đó không bị tính vào giới hạn lịch sử."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "固定的条目不受历史上限影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "釘選的項目不受歷史記錄上限影響。"
          }
        }
      }
    },
