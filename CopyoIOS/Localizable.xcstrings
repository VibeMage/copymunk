          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque posterior"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toucher le dos"
          }
        },
        "id": {
          "stringUnit": {
