    "Back Tap": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الضغط من الخلف"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf Rückseite tippen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back Tap"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque posterior"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toucher le dos"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocco posteriore"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "背面タップ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkaya Dokun"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点背面"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "背面輕點"
          }
        }
      }
    },
    "Back Tap can only run a shortcut, so it needs one that runs “Save Clipboard”.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن لميزة «الضغط من الخلف» إلا تشغيل اختصار، لذا تحتاج إلى اختصار يشغّل «حفظ الحافظة»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Auf Rückseite tippen“ kann nur einen Kurzbefehl ausführen, daher braucht es einen, der „Zwischenablage sichern“ ausführt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back Tap can only run a shortcut, so it needs one that runs “Save Clipboard”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque posterior solo puede ejecutar un atajo, así que necesita uno que ejecute “Guardar portapapeles”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le toucher du dos ne peut lancer qu’un raccourci : il lui en faut un qui exécute « Enregistrer le presse-papiers »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“Tocco posteriore” può eseguire solo un comando rapido, quindi ne serve uno che esegua “Salva appunti”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "背面タップで実行できるのはショートカットだけなので、「クリップボードを保存」を実行するショートカットが必要です。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkaya Dokun yalnızca bir kestirme çalıştırabilir; bu yüzden “Panoyu Kaydet” eylemini çalıştıran bir kestirme gerekir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点背面只能触发快捷指令，所以要先做一条运行「保存剪贴板」的快捷指令。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「背面輕點」只能執行捷徑，所以需要一個會執行「儲存剪貼板」的捷徑。"
          }
        }
      }
    },
    "Back Tap can only run a shortcut, which is why this one needs the shortcut above.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن لميزة «الضغط من الخلف» إلا تشغيل اختصار، ولهذا تحتاج هذه الطريقة إلى الاختصار أعلاه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Auf Rückseite tippen“ kann nur einen Kurzbefehl ausführen, deshalb braucht dieser Weg den Kurzbefehl oben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back Tap can only run a shortcut, which is why this one needs the shortcut above."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque posterior solo puede ejecutar un atajo; por eso este método necesita el atajo de arriba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le toucher du dos ne peut lancer qu’un raccourci : c’est pourquoi cette méthode a besoin du raccourci ci-dessus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“Tocco posteriore” può eseguire solo un comando rapido, per questo serve il comando rapido qui sopra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "背面タップで実行できるのはショートカットだけなので、上のショートカットが必要です。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkaya Dokun yalnızca bir kestirme çalıştırabilir; bu yöntemin yukarıdaki kestirmeye ihtiyaç duymasının nedeni budur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点背面只能触发快捷指令，所以这条通道需要上面那个快捷指令。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「背面輕點」只能執行捷徑，所以這個方式需要上面那個捷徑。"
          }
        }
      }
    },
