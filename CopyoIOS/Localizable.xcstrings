    "This deletes every clip that isn't pinned to a Pinboard. It can't be undone.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى حذف كل عنصر غير مثبّت في Pinboard. لا يمكن التراجع عن ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden alle Einträge gelöscht, die nicht an ein Pinboard angeheftet sind. Das lässt sich nicht widerrufen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This deletes every clip that isn’t pinned to a Pinboard. It can’t be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán todos los elementos que no estén fijados en un Pinboard. No se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime tous les éléments qui ne sont pas épinglés à un Pinboard. Cette action est irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verranno eliminati tutti gli elementi non fissati in un Pinboard. L’azione non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinboardにピン留めされていない項目がすべて削除されます。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinboard에 고정되지 않은 모든 항목이 삭제됩니다. 이 동작은 실행 취소할 수 없습니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem, bir Pinboard’a iğnelenmemiş tüm öğeleri siler. Geri alınamaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này sẽ xóa mọi mục chưa được ghim vào Pinboard. Không thể hoàn tác thao tác này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会删除所有未固定到 Pinboard 的条目，且无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會刪除所有未釘選到 Pinboard 的項目，且無法還原。"
          }
        }
      }
    },
