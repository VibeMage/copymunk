    "iCloud is temporarily unavailable. Copymunk will try again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خدمة iCloud غير متاحة مؤقتًا. سيحاول Copymunk مجددًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ist vorübergehend nicht verfügbar. Copymunk versucht es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud is temporarily unavailable. Copymunk will try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud no está disponible temporalmente. Copymunk volverá a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud est temporairement indisponible. Copymunk réessaiera."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud tidak tersedia untuk sementara. Copymunk akan mencoba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud non è temporaneamente disponibile. Copymunk riproverà."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudは一時的に利用できません。Copymunkが再試行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud를 일시적으로 사용할 수 없습니다. Copymunk가 다시 시도합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud is tijdelijk niet beschikbaar. Copymunk probeert het opnieuw."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud временно недоступен. Copymunk повторит попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ไม่พร้อมใช้งานชั่วคราว Copymunk จะลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud geçici olarak kullanılamıyor. Copymunk yeniden deneyecek."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud tạm thời không khả dụng. Copymunk sẽ thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 暂时不可用，Copymunk 会自动重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 暫時無法使用，Copymunk 會自動重試。"
          }
        }
      }
    },
