    "Saves text, a link, or an image to Copymunk without opening the app.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحفظ نصًا أو رابطًا أو صورة في Copymunk دون فتح التطبيق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichert Text, einen Link oder ein Bild in Copymunk, ohne die App zu öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves text, a link, or an image to Copymunk without opening the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda texto, un enlace o una imagen en Copymunk sin abrir la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre un texte, un lien ou une image dans Copymunk sans ouvrir l’app."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyimpan teks, tautan, atau gambar ke Copymunk tanpa membuka app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva testo, un link o un’immagine in Copymunk senza aprire l’app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを開かずに、テキスト、リンク、画像をCopymunkに保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱을 열지 않고 텍스트, 링크 또는 이미지를 Copymunk에 저장합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaart tekst, een link of een afbeelding in Copymunk zonder de app te openen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняет текст, ссылку или изображение в Copymunk, не открывая приложение."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกข้อความ ลิงก์ หรือภาพไปยัง Copymunk โดยไม่ต้องเปิดแอป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamayı açmadan Copymunk’a metin, bağlantı veya görüntü kaydeder."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu văn bản, liên kết hoặc hình ảnh vào Copymunk mà không cần mở ứng dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把文本、链接或图片存进 Copymunk，不打开 App。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將文字、連結或影像儲存到 Copymunk，不必打開 App。"
          }
        }
      }
    },
