    "iOS asks every time": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسأل iOS في كل مرة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS fragt jedes Mal"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS asks every time"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS pregunta cada vez"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS demande à chaque fois"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS chiede ogni volta"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOSが毎回確認します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS가 매번 물어봄"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS her seferinde sorar"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS hỏi mỗi lần"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统每次弹窗确认"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 每次都會詢問"
          }
        }
      }
    },
    "iOS asks the first time Copymunk reads the clipboard. Tap Allow Paste; later you can set it to Allow in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسأل iOS في أول مرة يقرأ فيها Copymunk الحافظة. اضغط «السماح باللصق»؛ ويمكنك لاحقًا ضبطه على «السماح» في الإعدادات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS fragt, wenn Copymunk die Zwischenablage zum ersten Mal liest. Tippe auf „Einsetzen erlauben“; später kannst du die Option in den Einstellungen auf „Erlauben“ stellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS asks the first time Copymunk reads the clipboard. Tap Allow Paste; later you can set it to Allow in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS te preguntará la primera vez que Copymunk lea el portapapeles. Toca “Permitir pegar”; más adelante puedes cambiarlo a “Permitir” en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS vous le demande la première fois que Copymunk lit le presse-papiers. Touchez « Autoriser le collage » ; vous pourrez ensuite choisir « Autoriser » dans Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS te lo chiede la prima volta che Copymunk legge gli appunti. Tocca “Consenti”; più avanti puoi scegliere “Consenti” in Impostazioni, così non te lo chiederà più."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunkが初めてクリップボードを読み取るときにiOSが確認します。「ペーストを許可」をタップしてください。あとで「設定」で「許可」に変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk가 처음 클립보드를 읽을 때 iOS가 묻습니다. ‘붙여넣기 허용’을 탭하십시오. 나중에 설정에서 ‘허용’으로 변경할 수 있습니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk panoyu ilk kez okuduğunda iOS size sorar. “Yapıştırmaya İzin Ver”e dokunun; daha sonra Ayarlar’da bunu “İzin Ver” olarak değiştirebilirsiniz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS sẽ hỏi vào lần đầu tiên Copymunk đọc bảng nhớ tạm. Hãy chạm vào “Cho phép dán”; sau này bạn có thể đặt thành “Cho phép” trong Cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk 第一次读剪贴板时 iOS 会问你，点「允许粘贴」；之后可在系统设置里改成「允许」。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk 第一次讀取剪貼板時，iOS 會詢問你，請點一下「允許貼上」；之後可在「設定」中改為「允許」。"
          }
        }
      }
    },
    "iOS won't let apps read the clipboard in the background, so Copymunk only saves at these three moments.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يسمح iOS للتطبيقات بقراءة الحافظة في الخلفية، لذا لا يحفظ Copymunk إلا في هذه اللحظات الثلاث."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS lässt Apps die Zwischenablage nicht im Hintergrund lesen, daher sichert Copymunk nur in diesen drei Momenten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS won’t let apps read the clipboard in the background, so Copymunk only saves at these three moments."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS no permite que las apps lean el portapapeles en segundo plano, así que Copymunk solo guarda en estos tres momentos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS n’autorise pas les apps à lire le presse-papiers en arrière-plan : Copymunk n’enregistre donc qu’à ces trois moments."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS non consente alle app di leggere gli appunti in background, quindi Copymunk salva solo in questi tre momenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOSではアプリがバックグラウンドでクリップボードを読み取れないため、Copymunkはこの3つのタイミングでのみ保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS에서는 앱이 백그라운드에서 클립보드를 읽을 수 없으므로 Copymunk는 다음 세 가지 경우에만 저장합니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS, uygulamaların panoyu arka planda okumasına izin vermez; bu yüzden Copymunk yalnızca şu üç durumda kaydeder."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS không cho phép ứng dụng đọc bảng nhớ tạm trong nền, vì vậy Copymunk chỉ lưu vào ba thời điểm này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 不允许 App 在后台读剪贴板，所以 Copymunk 只在这三种时刻保存内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 不允許 App 在背景讀取剪貼板，所以 Copymunk 只會在這三個時機儲存內容。"
          }
        }
      }
    },
    "iOS won't let apps read the clipboard in the background. Copymunk only saves at these three moments.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يسمح iOS للتطبيقات بقراءة الحافظة في الخلفية. لا يحفظ Copymunk إلا في هذه اللحظات الثلاث."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS lässt Apps die Zwischenablage nicht im Hintergrund lesen. Copymunk sichert nur in diesen drei Momenten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS won’t let apps read the clipboard in the background. Copymunk only saves at these three moments."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS no permite que las apps lean el portapapeles en segundo plano. Copymunk solo guarda en estos tres momentos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS n’autorise pas les apps à lire le presse-papiers en arrière-plan. Copymunk n’enregistre qu’à ces trois moments."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS non consente alle app di leggere gli appunti in background. Copymunk salva solo in questi tre momenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOSではアプリがバックグラウンドでクリップボードを読み取れません。Copymunkはこの3つのタイミングでのみ保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS에서는 앱이 백그라운드에서 클립보드를 읽을 수 없습니다. Copymunk는 다음 세 가지 경우에만 저장합니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS, uygulamaların panoyu arka planda okumasına izin vermez. Copymunk yalnızca şu üç durumda kaydeder."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS không cho phép ứng dụng đọc bảng nhớ tạm trong nền. Copymunk chỉ lưu vào ba thời điểm này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 不允许 App 在后台读剪贴板，Copymunk 只在这三种时刻保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 不允許 App 在背景讀取剪貼板，Copymunk 只會在這三個時機儲存。"
          }
        }
      }
    },
