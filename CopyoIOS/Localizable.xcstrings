    "Swipe a card right in History, or long-press it and pick this pinboard.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب بطاقة إلى اليسار في السجل، أو المسها مطولًا واختر Pinboard هذا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Streiche im Verlauf eine Karte nach rechts oder drücke lange darauf und wähle dieses Pinboard."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe a card right in History, or long-press it and pick this pinboard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza una tarjeta a la derecha en el historial, o mantenla pulsada y elige este Pinboard."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balayez une carte vers la droite dans l’historique, ou appuyez longuement dessus pour choisir ce Pinboard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri una scheda verso destra nella cronologia, oppure tienila premuta e scegli questo Pinboard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴でカードを右にスワイプするか、長押ししてこのPinboardを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록에서 카드를 오른쪽으로 쓸어넘기거나, 길게 누른 다음 이 Pinboard를 선택하십시오."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçmiş’te bir kartı sağa kaydırın veya kartı basılı tutup bu Pinboard’u seçin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuốt sang phải trên một thẻ trong Lịch sử, hoặc chạm và giữ thẻ rồi chọn Pinboard này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在历史里右滑卡片，或长按选「固定到 Pinboard」。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在歷史記錄中向右滑動卡片，或按住卡片並選擇這個 Pinboard。"
          }
        }
      }
    },
    "Swipe to “Controls”, then tap “Choose a Control”": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرّر إلى «عناصر التحكم»، ثم اضغط «اختيار عنصر تحكم»"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Streiche zu „Steuerelemente“ und tippe auf „Steuerelement auswählen“"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe to “Controls”, then tap “Choose a Control”"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza hasta “Controles” y toca “Elegir un control”"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Allez à « Commandes », puis touchez « Choisir une commande »"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri fino a “Controlli”, poi tocca “Scegli un controllo”"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「コントロール」までスワイプして、「コントロールを選択…」をタップ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘제어 항목’으로 쓸어넘긴 다음 ‘제어 항목 선택…’ 탭"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Denetimler”e kaydırın, ardından “Bir Denetim Seçin”e dokunun"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuốt đến “Điều khiển”, rồi chạm vào “Chọn một điều khiển…”"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "滑到「控件」，点「选取控件」"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "滑到「控制項目」，再點一下「選擇控制項目」"
          }
        }
      }
    },
    "Switch to the Copymunk keyboard in any text field and tap a card to type it — no jumping between apps.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدّل إلى لوحة مفاتيح Copymunk في أي حقل نص واضغط بطاقة لكتابتها — دون التنقل بين التطبيقات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wechsle in einem beliebigen Textfeld zur Copymunk-Tastatur und tippe auf eine Karte, um sie einzufügen – ganz ohne App-Wechsel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch to the Copymunk keyboard in any text field and tap a card to type it — no jumping between apps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia al teclado Copymunk en cualquier campo de texto y toca una tarjeta para escribirla — sin saltar de una app a otra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans n’importe quel champ de saisie, passez au clavier Copymunk et touchez une carte pour l’insérer, sans changer d’app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa alla tastiera Copymunk in qualsiasi campo di testo e tocca una scheda per inserirla, senza saltare da un’app all’altra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意のテキストフィールドでCopymunkキーボードに切り替え、カードをタップすると入力できます。アプリを行き来する必要はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아무 텍스트 필드에서나 Copymunk 키보드로 전환한 다음 카드를 탭하면 바로 입력됩니다. 앱을 오갈 필요가 없습니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Herhangi bir metin alanında Copymunk klavyesine geçin ve yazmak için bir karta dokunun — uygulamalar arasında gidip gelmenize gerek yok."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyển sang bàn phím Copymunk trong bất kỳ trường văn bản nào và chạm vào một thẻ để nhập nội dung đó — không cần chuyển qua lại giữa các ứng dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在任何输入框里切换到 Copymunk 键盘，点卡片直接输入内容，不用来回切 App。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在任何文字欄位中切換到 Copymunk 鍵盤，點一下卡片即可輸入——不必在 App 之間來回切換。"
          }
        }
      }
    },
