    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Privacy - Photo Library Additions Usage Description",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحفظ Copymunk الصورة التي تختارها في مكتبة الصور."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copymunk sichert das ausgewählte Bild in deiner Fotomediathek."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copymunk saves the image you choose to your photo library."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copymunk guarda en tu fototeca la imagen que elijas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copymunk enregistre l’image choisie dans votre photothèque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copymunk salva nella libreria foto l’immagine che scegli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copymunkは選択した画像を写真ライブラリに保存します。"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copymunk seçtiğiniz görüntüyü fotoğraf arşivinize kaydeder."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
