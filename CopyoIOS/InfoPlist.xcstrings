    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Privacy - Photo Library Additions Usage Description",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحفظ Copymunk الصورة التي تختارها في مكتبة الصور."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copymunk sichert das ausgewählte Bild in deiner Fotomediathek."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copymunk saves the image you choose to your photo library."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copymunk guarda en tu fototeca la imagen que elijas."
          }
        },
