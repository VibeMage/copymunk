          "stringUnit" : {
            "state" : "translated",
            "value" : "Copymunk enregistre l’image choisie dans votre photothèque."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copymunk menyimpan gambar yang Anda pilih ke perpustakaan foto Anda."
