        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Copymunk salva na sua Fototeca a imagem que você escolher."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
