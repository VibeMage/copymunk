        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi thứ bạn đã sao chép đều ở đây. Nhấn %@ để lấy lại bất cứ lúc nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制过的东西都在这里，按 %@ 随时取回。"
