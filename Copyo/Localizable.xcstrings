    "Everything you’ve copied is here. Press %@ to get it back anytime.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل ما نسخته موجود هنا. اضغط %@ لاستعادته في أي وقت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles, was du kopiert hast, ist hier. Drücke %@, um es jederzeit zurückzuholen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que has copiado está aquí. Pulsa %@ para recuperarlo cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce que vous avez copié est ici. Appuyez sur %@ pour le retrouver à tout moment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto ciò che hai copiato è qui. Premi %@ per ritrovarlo quando vuoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピーしたものはすべてここにあります。%@を押せば、いつでも呼び出せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복사한 모든 항목이 여기에 있습니다. 언제든지 %@ 키를 눌러 다시 꺼내 쓰십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь все, что Вы скопировали. Нажмите %@, чтобы открыть это в любой момент."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกสิ่งที่คุณเคยคัดลอกอยู่ที่นี่ กด %@ เพื่อเรียกกลับมาได้ทุกเมื่อ"
