    "This combination is already used by a macOS keyboard shortcut. Restored to %@.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Kombination wird bereits von einem macOS-Tastaturkurzbefehl verwendet. Zurückgesetzt auf %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette combinaison est déjà utilisée par un raccourci clavier de macOS. Rétablie sur %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个组合已被系统快捷键占用，已恢复为 %@"
          }
        }
      }
    },
    "This combination is already used by another app. Restored to %@.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Kombination wird bereits von einer anderen App verwendet. Zurückgesetzt auf %@."
