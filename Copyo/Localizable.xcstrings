    "This combination is already used by a macOS keyboard shortcut. Restored to %@.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه التركيبة مستخدمة بالفعل كاختصار لوحة مفاتيح في macOS. تمت الاستعادة إلى %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Kombination wird bereits von einem macOS-Tastaturkurzbefehl verwendet. Zurückgesetzt auf %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta combinación ya la usa una función rápida de teclado de macOS. Se ha restablecido a %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette combinaison est déjà utilisée par un raccourci clavier de macOS. Rétablie sur %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa combinazione è già usata da un’abbreviazione da tastiera di macOS. Ripristinata a %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この組み合わせはmacOSのキーボードショートカットですでに使われています。%@に戻しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 조합은 이미 macOS 키보드 단축키로 사용 중입니다. %@(으)로 복원되었습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это сочетание уже занято сочетанием клавиш macOS. Восстановлено: %@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปุ่มผสมนี้ถูกใช้เป็นปุ่มลัดแป้นพิมพ์ของ macOS อยู่แล้ว จึงกู้คืนเป็น %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kombinasyon zaten bir macOS klavye kısayolu tarafından kullanılıyor. Geri yüklenen kısayol: %@."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tổ hợp này đã được dùng cho một phím tắt bàn phím của macOS. Đã khôi phục về %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个组合已被系统快捷键占用，已恢复为 %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個組合已被系統快速鍵佔用，已回復為 %@"
          }
        }
      }
    },
