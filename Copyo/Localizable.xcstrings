    "Copymunk could not delete your clipboard history.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على Copymunk حذف سجل الحافظة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk konnte deinen Zwischenablageverlauf nicht löschen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk no ha podido eliminar tu historial del portapapeles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk n’a pas pu supprimer votre historique du presse-papiers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk non ha potuto eliminare la cronologia degli appunti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunkはクリップボード履歴を削除できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk가 클립보드 기록을 삭제할 수 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk не удалось удалить историю буфера обмена."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk ไม่สามารถลบประวัติคลิปบอร์ดของคุณได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk pano geçmişinizi silemedi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk không thể xóa lịch sử bảng nhớ tạm của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk 无法删除你的剪贴板历史。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk 無法刪除你的剪貼板歷史記錄。"
          }
        }
      }
    },
    "Copymunk could not reach your sync folder, so the copy there was not deleted. Choose the folder again in Settings, or delete it yourself.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على Copymunk الوصول إلى مجلد المزامنة، لذا لم تُحذف النسخة الموجودة هناك. أعد اختيار المجلد في الإعدادات، أو احذفها بنفسك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk konnte deinen Sync-Ordner nicht erreichen, daher wurde die Kopie dort nicht gelöscht. Wähle den Ordner in den Einstellungen erneut aus oder lösche sie selbst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk no ha podido acceder a tu carpeta de sincronización, así que la copia que hay allí no se ha eliminado. Vuelve a elegir la carpeta en Ajustes o elimínala manualmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk n’a pas pu accéder à votre dossier de synchronisation : la copie qui s’y trouve n’a pas été supprimée. Resélectionnez ce dossier dans les Réglages, ou supprimez-le vous-même."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk non ha potuto raggiungere la cartella di sincronizzazione, quindi la copia che si trova lì non è stata eliminata. Scegli di nuovo la cartella in Impostazioni oppure eliminala manualmente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunkが同期フォルダにアクセスできなかったため、そこにあるコピーは削除されていません。設定でフォルダを選び直すか、ご自身で削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk가 동기화 폴더에 접근할 수 없어 해당 폴더의 사본은 삭제되지 않았습니다. 설정에서 폴더를 다시 선택하거나 직접 삭제하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk не удалось получить доступ к папке синхронизации, поэтому копия в ней не удалена. Выберите папку заново в настройках или удалите копию самостоятельно."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk เข้าถึงโฟลเดอร์เชื่อมข้อมูลของคุณไม่ได้ จึงไม่ได้ลบสำเนาที่อยู่ในนั้น โปรดเลือกโฟลเดอร์อีกครั้งในการตั้งค่า หรือลบด้วยตัวเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk eşzamanlama klasörünüze erişemediği için oradaki kopya silinmedi. Klasörü Ayarlar’da yeniden seçin veya kopyayı kendiniz silin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk không thể truy cập thư mục đồng bộ hóa của bạn nên bản sao ở đó chưa bị xóa. Hãy chọn lại thư mục đó trong Cài đặt hoặc tự xóa bản sao."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk 够不着你的同步文件夹，那里的副本没有被删除。请在「设置」里重新选一次那个文件夹，或者自己把它删掉。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk 無法連到你的同步資料夾，所以那裡的副本沒有被刪除。請在「設定」中重新選擇該資料夾，或自行將它刪除。"
          }
        }
      }
    },
    "Copymunk could not restart itself.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على Copymunk إعادة تشغيل نفسه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk konnte sich nicht selbst neu starten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk no ha podido reiniciarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk n’a pas pu se relancer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk non ha potuto riavviarsi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunkを自動で再起動できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk가 스스로 다시 시작할 수 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk не удалось перезапуститься."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk ไม่สามารถเริ่มการทำงานใหม่เองได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk kendini yeniden başlatamadı."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk không thể tự khởi động lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk 无法自行重启。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk 無法自行重新啟動。"
          }
        }
      }
    },
    "Copymunk deletes the snapshots and images it put in your sync folder, and turns Shared Folder sync off: folder sync has no way to tell your other Macs to delete anything, so leaving it on would copy their history straight back. What those Macs put in the folder stays until you delete it yourself.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحذف Copymunk اللقطات والصور التي وضعها في مجلد المزامنة، ويوقف مزامنة «مجلد مشترك»: فمزامنة المجلد لا تملك أي طريقة لإبلاغ أجهزة Mac الأخرى بحذف شيء، وإبقاؤها قيد التشغيل سيعيد نسخ سجلها مباشرةً. أما ما وضعته أجهزة Mac تلك في المجلد فيبقى حتى تحذفه بنفسك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk löscht die Schnappschüsse und Bilder, die es in deinem Sync-Ordner abgelegt hat, und schaltet die Synchronisierung über „Geteilter Ordner“ aus: Die Ordner-Synchronisierung kann deinen anderen Macs nicht mitteilen, etwas zu löschen. Bliebe sie an, würde deren Verlauf sofort wieder zurückkopiert. Was diese Macs im Ordner abgelegt haben, bleibt dort, bis du es selbst löschst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk elimina las instantáneas y las imágenes que puso en tu carpeta de sincronización y desactiva la sincronización con “Carpeta compartida”: la sincronización por carpeta no tiene forma de indicar a tus otros Mac que eliminen nada, así que, si siguiera activada, su historial volvería a copiarse enseguida. Lo que esos Mac hayan puesto en la carpeta se queda ahí hasta que lo elimines manualmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk supprime les instantanés et les images qu’il a placés dans votre dossier de synchronisation, et désactive la synchronisation par dossier : celle-ci n’a aucun moyen de demander à vos autres Mac de supprimer quoi que ce soit, donc la laisser active y recopierait aussitôt leur historique. Ce que ces Mac ont placé dans le dossier y reste jusqu’à ce que vous le supprimiez vous-même."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk elimina le istantanee e le immagini che ha salvato nella cartella di sincronizzazione e disattiva la sincronizzazione tramite “Cartella condivisa”: la sincronizzazione via cartella non ha modo di dire agli altri Mac di eliminare qualcosa, quindi, se restasse attiva, la loro cronologia verrebbe subito ricopiata. Ciò che quei Mac hanno messo nella cartella resta lì finché non lo elimini manualmente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunkは同期フォルダに書き込んだスナップショットと画像を削除し、「共有フォルダ」同期をオフにします。フォルダ同期にはほかのMacに削除を伝える手段がないため、オンのままだとそれらのMacの履歴がすぐにコピーし直されてしまいます。ほかのMacがフォルダに置いたものは、ご自身で削除するまで残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk가 동기화 폴더에 저장한 스냅샷과 이미지를 삭제하고 공유 폴더 동기화를 끕니다. 폴더 동기화로는 다른 Mac에 삭제를 알릴 방법이 없으므로, 켜 두면 그 Mac들의 기록이 그대로 다시 복사됩니다. 다른 Mac이 폴더에 넣은 항목은 직접 삭제할 때까지 남아 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk удалит снимки и изображения, которые он поместил в папку синхронизации, и выключит синхронизацию через общую папку: такая синхронизация не может сообщить другим Вашим компьютерам Mac, что нужно что-то удалить, поэтому, если оставить ее включенной, их история сразу скопируется обратно. То, что эти компьютеры Mac поместили в папку, останется там, пока Вы не удалите это сами."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk จะลบสแนปช็อตและภาพที่ตัวเองใส่ไว้ในโฟลเดอร์เชื่อมข้อมูล และปิดการเชื่อมข้อมูลแบบโฟลเดอร์ที่แชร์ เนื่องจากการเชื่อมข้อมูลผ่านโฟลเดอร์ไม่มีวิธีบอกให้ Mac เครื่องอื่นลบข้อมูล หากเปิดไว้ ประวัติจาก Mac เครื่องเหล่านั้นจะถูกคัดลอกกลับมาทันที ส่วนสิ่งที่ Mac เครื่องอื่นใส่ไว้ในโฟลเดอร์จะยังคงอยู่จนกว่าคุณจะลบเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk, eşzamanlama klasörünüze koyduğu anlık görüntüleri ve resimleri siler ve Paylaşılan Klasör eşzamanlamasını kapatır: Klasör eşzamanlaması diğer Mac’lerinize bir şey silmelerini söyleyemez; açık bırakılırsa onların geçmişi hemen geri kopyalanır. O Mac’lerin klasöre koyduğu içerikler, siz silene kadar orada kalır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk xóa các ảnh chụp nhanh và hình ảnh mà ứng dụng đã đặt vào thư mục đồng bộ hóa của bạn, đồng thời tắt đồng bộ hóa qua Thư mục được chia sẻ: đồng bộ hóa qua thư mục không có cách nào yêu cầu các máy Mac khác của bạn xóa dữ liệu, nên nếu vẫn bật, lịch sử của các máy đó sẽ được sao chép ngay trở lại. Những gì các máy Mac đó đặt vào thư mục sẽ vẫn còn cho đến khi bạn tự xóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk 会删掉自己写进同步文件夹的快照和图片，并把「共享文件夹」同步关掉：文件夹同步没有办法告诉其他 Mac 删除内容，继续开着的话它们的历史会原样灌回来。其他 Mac 放进那个文件夹的东西会一直留着，需要的话请自己删掉。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk 會刪除它寫進同步資料夾的快照和影像，並關閉「共享資料夾」同步：資料夾同步無法通知你的其他 Mac 刪除內容，若繼續開著，它們的歷史記錄會原封不動地再拷貝回來。其他 Mac 放進該資料夾的內容會一直保留，直到你自行刪除。"
          }
        }
      }
    },
    "Copymunk erased this Mac while iCloud sync was off, so the iCloud copy was never removed. Turning iCloud sync on can bring those entries back.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محا Copymunk بيانات جهاز Mac هذا بينما كانت مزامنة iCloud متوقفة، لذا لم تُحذف النسخة الموجودة على iCloud. قد يؤدي تشغيل مزامنة iCloud إلى إعادة تلك العناصر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk hat diesen Mac gelöscht, während iCloud-Sync aus war, daher wurde die iCloud-Kopie nie entfernt. Wenn du iCloud-Sync einschaltest, können diese Einträge zurückkommen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk borró este Mac mientras la sincronización con iCloud estaba desactivada, así que la copia de iCloud nunca se eliminó. Si activas la sincronización con iCloud, esos elementos pueden volver."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk a effacé ce Mac alors que la synchronisation iCloud était désactivée : la copie iCloud n’a jamais été supprimée. Réactiver la synchronisation iCloud peut faire revenir ces éléments."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk ha cancellato i dati di questo Mac mentre la sincronizzazione iCloud era disattivata, quindi la copia su iCloud non è mai stata rimossa. Se attivi la sincronizzazione iCloud, quegli elementi potrebbero tornare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CopymunkはiCloud同期がオフの状態でこのMacを消去したため、iCloud上のコピーは削除されていません。iCloud同期をオンにすると、それらの項目が戻ってくる場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 동기화가 꺼진 상태에서 Copymunk가 이 Mac을 지웠으므로 iCloud의 사본은 제거되지 않았습니다. iCloud 동기화를 켜면 해당 항목이 다시 돌아올 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk стер данные на этом Mac, когда синхронизация iCloud была выключена, поэтому копия в iCloud не удалена. Если включить синхронизацию iCloud, эти элементы могут вернуться."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk ลบข้อมูลบน Mac เครื่องนี้ขณะที่การเชื่อมข้อมูล iCloud ปิดอยู่ สำเนาบน iCloud จึงยังไม่ถูกลบ การเปิดการเชื่อมข้อมูล iCloud อาจทำให้รายการเหล่านั้นกลับมา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk bu Mac’i iCloud eşzamanlaması kapalıyken sildi, bu yüzden iCloud’daki kopya hiç kaldırılmadı. iCloud eşzamanlamasını açmak bu öğeleri geri getirebilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk đã xóa dữ liệu trên máy Mac này khi đồng bộ hóa iCloud đang tắt, vì vậy bản sao trên iCloud chưa hề bị xóa. Bật đồng bộ hóa iCloud có thể khiến các mục đó quay lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk 是在 iCloud 同步关闭时擦除这台 Mac 的，iCloud 上那份副本从未被删除。重新打开 iCloud 同步有可能把那些条目带回来。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk 是在 iCloud 同步關閉時清除這台 Mac 的，因此 iCloud 上的副本從未被移除。開啟 iCloud 同步可能會讓那些項目再回來。"
          }
        }
      }
    },
    "Copymunk is sending the deletion to your iCloud private database. Keep Copymunk open and signed in to iCloud. Copymunk cannot tell you when this has finished.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرسل Copymunk عملية الحذف إلى قاعدة بياناتك الخاصة على iCloud. أبقِ Copymunk مفتوحًا وابقَ مسجّل الدخول إلى iCloud. لا يستطيع Copymunk إعلامك بموعد اكتمال ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk sendet die Löschung an deine private iCloud-Datenbank. Lass Copymunk geöffnet und bleib bei iCloud angemeldet. Copymunk kann dir nicht sagen, wann der Vorgang abgeschlossen ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk está enviando la eliminación a tu base de datos privada de iCloud. Mantén Copymunk abierto y con la sesión de iCloud iniciada. Copymunk no puede avisarte de cuándo ha terminado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk envoie cette suppression vers votre base de données privée iCloud. Laissez Copymunk ouvert et restez connecté à iCloud. Copymunk ne peut pas vous dire quand l’envoi est terminé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk sta inviando l’eliminazione al tuo database privato iCloud. Tieni Copymunk aperto e con l’accesso a iCloud attivo. Copymunk non può avvisarti quando l’operazione è terminata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunkは削除をiCloudのプライベートデータベースに送信しています。Copymunkを開いたまま、iCloudにサインインした状態にしておいてください。送信がいつ完了するかをCopymunkからお知らせすることはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk가 iCloud 개인 데이터베이스로 삭제 요청을 보내는 중입니다. Copymunk를 열어 두고 iCloud에 로그인된 상태를 유지하십시오. Copymunk는 이 작업이 언제 완료되는지 알려 줄 수 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk отправляет удаление в Вашу частную базу данных iCloud. Не закрывайте Copymunk и не выходите из iCloud. Copymunk не может сообщить, когда отправка завершится."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk กำลังส่งการลบไปยังฐานข้อมูลส่วนตัวบน iCloud ของคุณ โปรดเปิด Copymunk ไว้และลงชื่อเข้า iCloud ไว้ Copymunk ไม่สามารถแจ้งได้ว่าจะเสร็จเมื่อใด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk silme işlemini iCloud özel veritabanınıza gönderiyor. Copymunk’u açık tutun ve iCloud oturumunuzu kapatmayın. Copymunk bu işlemin ne zaman bittiğini size bildiremez."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk đang gửi lệnh xóa đến cơ sở dữ liệu riêng tư iCloud của bạn. Hãy để Copymunk mở và giữ đăng nhập iCloud. Copymunk không thể cho bạn biết khi nào việc này hoàn tất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk 正在把这次删除发送到你的 iCloud 私有数据库。请让 Copymunk 保持打开并保持 iCloud 登录状态。Copymunk 无法告诉你它什么时候发送完。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk 正在將這次刪除傳送到你的 iCloud 私人資料庫。請讓 Copymunk 保持打開，並維持登入 iCloud。Copymunk 無法告訴你何時傳送完畢。"
          }
        }
      }
    },
    "Copymunk is using the local database only, so nothing was lost. Fix the problem above and restart Copymunk.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم Copymunk قاعدة البيانات المحلية فقط، لذا لم يُفقد أي شيء. أصلح المشكلة أعلاه ثم أعد تشغيل Copymunk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk verwendet nur die lokale Datenbank, es ist also nichts verloren gegangen. Behebe das Problem oben und starte Copymunk neu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk está usando solo la base de datos local, así que no se ha perdido nada. Soluciona el problema indicado arriba y reinicia Copymunk."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk utilise uniquement la base de données locale : rien n’a été perdu. Corrigez le problème ci-dessus, puis relancez Copymunk."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk sta usando solo il database locale, quindi non è andato perso nulla. Risolvi il problema indicato sopra e riavvia Copymunk."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunkはローカルデータベースのみを使用しているため、データは失われていません。上記の問題を解決してから、Copymunkを再起動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk가 로컬 데이터베이스만 사용 중이므로 손실된 데이터는 없습니다. 위의 문제를 해결한 다음 Copymunk를 다시 시작하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk использует только локальную базу данных, поэтому ничего не потеряно. Устраните проблему выше и перезапустите Copymunk."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk กำลังใช้เฉพาะฐานข้อมูลภายในเครื่อง จึงไม่มีข้อมูลสูญหาย โปรดแก้ไขปัญหาด้านบนแล้วเริ่ม Copymunk ใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk yalnızca yerel veritabanını kullanıyor, bu yüzden hiçbir şey kaybolmadı. Yukarıdaki sorunu giderin ve Copymunk’u yeniden başlatın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk hiện chỉ dùng cơ sở dữ liệu cục bộ nên không có gì bị mất. Hãy khắc phục sự cố ở trên rồi khởi động lại Copymunk."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk 正在只使用本地数据库，数据一条都没有丢失。解决上面的问题后重启 Copymunk 即可。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk 目前只使用本機資料庫，因此沒有遺失任何資料。解決上述問題後，請重新啟動 Copymunk。"
          }
        }
      }
    },
    "Copymunk lives in the menu bar (the chipmunk icon in the top-right corner).\n\n• Click the menu bar icon anytime to bring up the clipboard panel\n• Everything you copy is saved automatically — type to search\n• Pick an item and press Return to put it back on the clipboard, then paste it yourself with ⌘V. ⇧Return copies it as plain text\n• Open Settings from the gear in the panel, or by right-clicking the menu bar icon": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل Copymunk من شريط القائمة (أيقونة السنجاب في الزاوية العلوية اليسرى).\n\n• انقر على أيقونة شريط القائمة في أي وقت لإظهار لوحة الحافظة\n• يُحفظ كل ما تنسخه تلقائيًا — اكتب للبحث\n• اختر عنصرًا واضغط Return لإعادته إلى الحافظة، ثم الصقه بنفسك باستخدام ⁦⌘V⁩. أما ⁦⇧Return⁩ فينسخه كنص عادي\n• افتح الإعدادات من رمز الترس في اللوحة، أو بالنقر بزر الماوس الأيمن على أيقونة شريط القائمة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk sitzt in der Menüleiste (das Streifenhörnchen-Symbol oben rechts).\n\n• Klicke jederzeit auf das Menüleistensymbol, um das Zwischenablage-Panel einzublenden\n• Alles, was du kopierst, wird automatisch gesichert – einfach lostippen, um zu suchen\n• Wähle einen Eintrag und drücke ↩, um ihn zurück in die Zwischenablage zu legen, und setze ihn dann selbst mit ⌘V ein. ⇧↩ kopiert ihn als reinen Text\n• Öffne die Einstellungen über das Zahnrad im Panel oder per Rechtsklick auf das Menüleistensymbol"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk vive en la barra de menús (el icono de la ardilla, arriba a la derecha).\n\n• Haz clic en el icono de la barra de menús cuando quieras para abrir el panel del portapapeles\n• Todo lo que copias se guarda automáticamente; escribe para buscar\n• Elige un elemento y pulsa Retorno para devolverlo al portapapeles; después, pégalo tú con ⌘V. ⇧Retorno lo copia como texto sin formato\n• Abre los ajustes desde el engranaje del panel o haciendo clic con el botón derecho en el icono de la barra de menús"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk réside dans la barre des menus (l’icône de tamia en haut à droite).\n\n• Cliquez sur l’icône de la barre des menus à tout moment pour faire apparaître le panneau\n• Tout ce que vous copiez est enregistré automatiquement — saisissez pour rechercher\n• Choisissez un élément et appuyez sur Retour pour le replacer dans le presse-papiers, puis collez-le vous-même avec ⌘V. ⇧Retour le copie en texte brut\n• Ouvrez les réglages depuis la roue dentée du panneau ou en cliquant avec le bouton droit sur l’icône de la barre des menus"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk vive nella barra dei menu (l’icona dello scoiattolo in alto a destra).\n\n• Fai clic sull’icona nella barra dei menu quando vuoi per aprire il pannello degli appunti\n• Tutto ciò che copi viene salvato automaticamente: digita per cercare\n• Scegli un elemento e premi ↩ per rimetterlo negli appunti, poi incollalo tu con ⌘V. ⇧↩ lo copia come solo testo\n• Apri le impostazioni dall’ingranaggio nel pannello o facendo clic con il tasto destro sull’icona nella barra dei menu"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunkはメニューバーに常駐しています（右上のシマリスのアイコン）。\n\n• メニューバーのアイコンをクリックすると、いつでもクリップボードパネルを表示できます\n• コピーしたものはすべて自動で保存されます。入力するだけで検索できます\n• 項目を選んでreturnキーを押すとクリップボードに戻ります。その後、ご自身で⌘Vを押してペーストしてください。⇧returnではプレーンテキストとしてコピーします\n• 設定は、パネルの歯車アイコンをクリックするか、メニューバーのアイコンを右クリックして開けます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk는 메뉴 막대(오른쪽 상단의 다람쥐 아이콘)에서 실행됩니다.\n\n• 언제든지 메뉴 막대 아이콘을 클릭하면 클립보드 패널이 열립니다\n• 복사한 모든 항목은 자동으로 저장되며, 입력하면 바로 검색됩니다\n• 항목을 선택하고 Return 키를 누르면 클립보드로 돌아가며, 붙여넣기는 직접 ⌘V로 합니다. ⇧Return 키를 누르면 일반 텍스트로 복사됩니다\n• 설정은 패널의 톱니바퀴 버튼을 클릭하거나 메뉴 막대 아이콘을 오른쪽 클릭하여 열 수 있습니다"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk находится в строке меню (значок бурундука в правом верхнем углу).\n\n• Нажмите значок в строке меню в любой момент, чтобы открыть панель буфера обмена\n• Все, что Вы копируете, сохраняется автоматически — для поиска просто начните вводить текст\n• Выберите элемент и нажмите ↩, чтобы вернуть его в буфер обмена, а затем вставьте его сами с помощью ⌘V. ⇧↩ копирует как простой текст\n• Настройки открываются шестеренкой на панели или нажатием правой кнопкой мыши на значок в строке меню"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk อยู่ในแถบเมนู (ไอคอนชิปมังก์ที่มุมขวาบน)\n\n• คลิกไอคอนในแถบเมนูเมื่อใดก็ได้เพื่อเรียกแผงคลิปบอร์ด\n• ทุกสิ่งที่คุณคัดลอกจะถูกบันทึกโดยอัตโนมัติ พิมพ์เพื่อค้นหาได้เลย\n• เลือกรายการแล้วกด Return เพื่อนำกลับไปไว้ในคลิปบอร์ด จากนั้นวางเองด้วย ⌘V ส่วน ⇧Return จะคัดลอกเป็นข้อความธรรมดา\n• เปิดการตั้งค่าได้จากไอคอนรูปเฟืองในแผง หรือคลิกขวาที่ไอคอนในแถบเมนู"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk menü çubuğunda çalışır (sağ üst köşedeki sincap simgesi).\n\n• Pano panelini açmak için istediğiniz zaman menü çubuğu simgesine tıklayın\n• Kopyaladığınız her şey otomatik olarak kaydedilir — aramak için yazmaya başlayın\n• Bir öğe seçip Return tuşuna basarak onu panoya geri koyun, ardından ⌘V ile kendiniz yapıştırın. ⇧Return düz metin olarak kopyalar\n• Ayarlar’ı paneldeki dişli simgesinden veya menü çubuğu simgesine sağ tıklayarak açın"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk nằm trên thanh menu (biểu tượng sóc chuột ở góc trên bên phải).\n\n• Bấm vào biểu tượng trên thanh menu bất cứ lúc nào để mở bảng Copymunk\n• Mọi thứ bạn sao chép đều được lưu tự động — nhập để tìm kiếm\n• Chọn một mục và nhấn Return để đặt mục đó trở lại bảng nhớ tạm, sau đó tự dán bằng ⌘V. ⇧Return sao chép mục đó dạng văn bản thuần túy\n• Mở Cài đặt từ biểu tượng bánh răng trong bảng hoặc bằng cách bấm chuột phải vào biểu tượng trên thanh menu"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk 已在菜单栏常驻运行（右上角的花栗鼠图标）。\n\n• 点按菜单栏图标随时呼出剪贴板面板\n• 复制过的内容会自动记录，输入即可搜索\n• 选中条目按回车放回剪贴板，再由你自己按 ⌘V 粘贴；⇧回车以纯文本复制\n• 点击面板右上角的齿轮，或右键菜单栏图标，即可打开设置"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk 常駐在選單列中（右上角的花栗鼠圖像）。\n\n• 隨時按一下選單列圖像即可叫出剪貼板面板\n• 你拷貝的所有內容都會自動儲存，直接輸入即可搜尋\n• 選取項目後按下 Return 將它放回剪貼板，再由你自己按 ⌘V 貼上；⇧Return 會以純文字拷貝\n• 按一下面板中的齒輪，或在選單列圖像上按右鍵，即可打開設定"
          }
        }
      }
    },
    "Copymunk lives in the menu bar (the chipmunk icon in the top-right corner).\n\n• Press %@ anytime to bring up the clipboard panel\n• Everything you copy is saved automatically — type to search\n• Pick an item and press Return to put it back on the clipboard, then paste it yourself with ⌘V. ⇧Return copies it as plain text\n• Open Settings from the gear in the panel, or by right-clicking the menu bar icon": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل Copymunk من شريط القائمة (أيقونة السنجاب في الزاوية العلوية اليسرى).\n\n• اضغط %@ في أي وقت لإظهار لوحة الحافظة\n• يُحفظ كل ما تنسخه تلقائيًا — اكتب للبحث\n• اختر عنصرًا واضغط Return لإعادته إلى الحافظة، ثم الصقه بنفسك باستخدام ⁦⌘V⁩. أما ⁦⇧Return⁩ فينسخه كنص عادي\n• افتح الإعدادات من رمز الترس في اللوحة، أو بالنقر بزر الماوس الأيمن على أيقونة شريط القائمة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk sitzt in der Menüleiste (das Streifenhörnchen-Symbol oben rechts).\n\n• Drücke jederzeit %@, um das Zwischenablage-Panel einzublenden\n• Alles, was du kopierst, wird automatisch gesichert – einfach lostippen, um zu suchen\n• Wähle einen Eintrag und drücke ↩, um ihn zurück in die Zwischenablage zu legen, und setze ihn dann selbst mit ⌘V ein. ⇧↩ kopiert ihn als reinen Text\n• Öffne die Einstellungen über das Zahnrad im Panel oder per Rechtsklick auf das Menüleistensymbol"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk vive en la barra de menús (el icono de la ardilla, arriba a la derecha).\n\n• Pulsa %@ cuando quieras para abrir el panel del portapapeles\n• Todo lo que copias se guarda automáticamente; escribe para buscar\n• Elige un elemento y pulsa Retorno para devolverlo al portapapeles; después, pégalo tú con ⌘V. ⇧Retorno lo copia como texto sin formato\n• Abre los ajustes desde el engranaje del panel o haciendo clic con el botón derecho en el icono de la barra de menús"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk réside dans la barre des menus (l’icône de tamia en haut à droite).\n\n• Appuyez sur %@ à tout moment pour faire apparaître le panneau\n• Tout ce que vous copiez est enregistré automatiquement — saisissez pour rechercher\n• Choisissez un élément et appuyez sur Retour pour le replacer dans le presse-papiers, puis collez-le vous-même avec ⌘V. ⇧Retour le copie en texte brut\n• Ouvrez les réglages depuis la roue dentée du panneau ou en cliquant avec le bouton droit sur l’icône de la barre des menus"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk vive nella barra dei menu (l’icona dello scoiattolo in alto a destra).\n\n• Premi %@ quando vuoi per aprire il pannello degli appunti\n• Tutto ciò che copi viene salvato automaticamente: digita per cercare\n• Scegli un elemento e premi ↩ per rimetterlo negli appunti, poi incollalo tu con ⌘V. ⇧↩ lo copia come solo testo\n• Apri le impostazioni dall’ingranaggio nel pannello o facendo clic con il tasto destro sull’icona nella barra dei menu"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunkはメニューバーに常駐しています（右上のシマリスのアイコン）。\n\n• %@を押すと、いつでもクリップボードパネルを表示できます\n• コピーしたものはすべて自動で保存されます。入力するだけで検索できます\n• 項目を選んでreturnキーを押すとクリップボードに戻ります。その後、ご自身で⌘Vを押してペーストしてください。⇧returnではプレーンテキストとしてコピーします\n• 設定は、パネルの歯車アイコンをクリックするか、メニューバーのアイコンを右クリックして開けます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk는 메뉴 막대(오른쪽 상단의 다람쥐 아이콘)에서 실행됩니다.\n\n• 언제든지 %@ 키를 누르면 클립보드 패널이 열립니다\n• 복사한 모든 항목은 자동으로 저장되며, 입력하면 바로 검색됩니다\n• 항목을 선택하고 Return 키를 누르면 클립보드로 돌아가며, 붙여넣기는 직접 ⌘V로 합니다. ⇧Return 키를 누르면 일반 텍스트로 복사됩니다\n• 설정은 패널의 톱니바퀴 버튼을 클릭하거나 메뉴 막대 아이콘을 오른쪽 클릭하여 열 수 있습니다"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk находится в строке меню (значок бурундука в правом верхнем углу).\n\n• Нажмите %@ в любой момент, чтобы открыть панель буфера обмена\n• Все, что Вы копируете, сохраняется автоматически — для поиска просто начните вводить текст\n• Выберите элемент и нажмите ↩, чтобы вернуть его в буфер обмена, а затем вставьте его сами с помощью ⌘V. ⇧↩ копирует как простой текст\n• Настройки открываются шестеренкой на панели или нажатием правой кнопкой мыши на значок в строке меню"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk อยู่ในแถบเมนู (ไอคอนชิปมังก์ที่มุมขวาบน)\n\n• กด %@ เมื่อใดก็ได้เพื่อเรียกแผงคลิปบอร์ด\n• ทุกสิ่งที่คุณคัดลอกจะถูกบันทึกโดยอัตโนมัติ พิมพ์เพื่อค้นหาได้เลย\n• เลือกรายการแล้วกด Return เพื่อนำกลับไปไว้ในคลิปบอร์ด จากนั้นวางเองด้วย ⌘V ส่วน ⇧Return จะคัดลอกเป็นข้อความธรรมดา\n• เปิดการตั้งค่าได้จากไอคอนรูปเฟืองในแผง หรือคลิกขวาที่ไอคอนในแถบเมนู"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk menü çubuğunda çalışır (sağ üst köşedeki sincap simgesi).\n\n• Pano panelini açmak için istediğiniz zaman %@ tuşlarına basın\n• Kopyaladığınız her şey otomatik olarak kaydedilir — aramak için yazmaya başlayın\n• Bir öğe seçip Return tuşuna basarak onu panoya geri koyun, ardından ⌘V ile kendiniz yapıştırın. ⇧Return düz metin olarak kopyalar\n• Ayarlar’ı paneldeki dişli simgesinden veya menü çubuğu simgesine sağ tıklayarak açın"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk nằm trên thanh menu (biểu tượng sóc chuột ở góc trên bên phải).\n\n• Nhấn %@ bất cứ lúc nào để mở bảng Copymunk\n• Mọi thứ bạn sao chép đều được lưu tự động — nhập để tìm kiếm\n• Chọn một mục và nhấn Return để đặt mục đó trở lại bảng nhớ tạm, sau đó tự dán bằng ⌘V. ⇧Return sao chép mục đó dạng văn bản thuần túy\n• Mở Cài đặt từ biểu tượng bánh răng trong bảng hoặc bằng cách bấm chuột phải vào biểu tượng trên thanh menu"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk 已在菜单栏常驻运行（右上角的花栗鼠图标）。\n\n• 按 %@ 随时呼出剪贴板面板\n• 复制过的内容会自动记录，输入即可搜索\n• 选中条目按回车放回剪贴板，再由你自己按 ⌘V 粘贴；⇧回车以纯文本复制\n• 点击面板右上角的齿轮，或右键菜单栏图标，即可打开设置"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk 常駐在選單列中（右上角的花栗鼠圖像）。\n\n• 隨時按下 %@ 即可叫出剪貼板面板\n• 你拷貝的所有內容都會自動儲存，直接輸入即可搜尋\n• 選取項目後按下 Return 將它放回剪貼板，再由你自己按 ⌘V 貼上；⇧Return 會以純文字拷貝\n• 按一下面板中的齒輪，或在選單列圖像上按右鍵，即可打開設定"
          }
        }
      }
    },
    "Copymunk records in the background and needs no permissions": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسجّل Copymunk في الخلفية ولا يحتاج إلى أي أذونات"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk erfasst im Hintergrund und braucht keine Berechtigungen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk registra en segundo plano y no necesita ningún permiso"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk enregistre en arrière-plan, sans aucune autorisation"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk registra in background e non richiede alcuna autorizzazione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunkはバックグラウンドで記録し、アクセス権は必要ありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk는 백그라운드에서 기록하며 별도의 권한이 필요하지 않음"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk записывает в фоновом режиме и не требует разрешений"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk บันทึกในเบื้องหลังและไม่ต้องใช้สิทธิ์ใดๆ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk arka planda kaydeder ve hiçbir izin gerektirmez"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk ghi lại trong nền và không cần quyền nào"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk 在后台记录，不需要任何权限"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk 在背景記錄，不需要任何權限"
          }
        }
      }
    },
    "Copymunk restarts and clears the database file, so the entries you deleted cannot be recovered from this Mac. Anything the deletion has not reached in your iCloud private database stays there and will come back to this Mac.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُعيد Copymunk تشغيل نفسه ويمسح ملف قاعدة البيانات، فلا يمكن استعادة العناصر التي حذفتها من جهاز Mac هذا. أما ما لم يصل إليه الحذف في قاعدة بياناتك الخاصة على iCloud فيبقى هناك وسيعود إلى جهاز Mac هذا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk startet neu und leert die Datenbankdatei, damit sich die gelöschten Einträge auf diesem Mac nicht wiederherstellen lassen. Was die Löschung in deiner privaten iCloud-Datenbank noch nicht erreicht hat, bleibt dort und kommt auf diesen Mac zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk se reinicia y borra el archivo de la base de datos, así que los elementos que eliminaste ya no se podrán recuperar desde este Mac. Lo que la eliminación aún no haya alcanzado en tu base de datos privada de iCloud se quedará allí y volverá a este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk se relance et efface le fichier de base de données : les éléments supprimés ne pourront plus être récupérés depuis ce Mac. Ce que la suppression n’a pas atteint dans votre base de données privée iCloud y reste et reviendra sur ce Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk si riavvia e cancella il file del database, così gli elementi eliminati non potranno più essere recuperati da questo Mac. Ciò che l’eliminazione non ha ancora raggiunto nel tuo database privato iCloud resta lì e tornerà su questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunkは再起動してデータベースファイルを消去するため、削除した項目はこのMacから復元できなくなります。iCloudのプライベートデータベースのうち、まだ削除が届いていない分はそこに残り、このMacに戻ってきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk가 다시 시작되면서 데이터베이스 파일을 지우므로, 삭제한 항목을 이 Mac에서 복구할 수 없게 됩니다. iCloud 개인 데이터베이스에서 아직 삭제가 반영되지 않은 항목은 그대로 남아 있다가 이 Mac으로 다시 돌아옵니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk перезапустится и очистит файл базы данных, чтобы удаленные элементы нельзя было восстановить с этого Mac. То, до чего удаление еще не дошло в Вашей частной базе данных iCloud, останется там и вернется на этот Mac."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk จะเริ่มการทำงานใหม่และล้างไฟล์ฐานข้อมูล เพื่อไม่ให้กู้คืนรายการที่คุณลบจาก Mac เครื่องนี้ได้ ส่วนข้อมูลในฐานข้อมูลส่วนตัวบน iCloud ที่การลบยังไปไม่ถึงจะยังคงอยู่ที่นั่นและจะกลับมายัง Mac เครื่องนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk yeniden başlar ve veritabanı dosyasını temizler; böylece sildiğiniz öğeler bu Mac’ten kurtarılamaz. iCloud özel veritabanınızda silme işleminin henüz ulaşmadığı içerikler orada kalır ve bu Mac’e geri gelir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk sẽ khởi động lại và xóa sạch tệp cơ sở dữ liệu để các mục bạn đã xóa không thể khôi phục từ máy Mac này. Phần nào trong cơ sở dữ liệu riêng tư iCloud mà lệnh xóa chưa đến được sẽ vẫn ở đó và sẽ quay lại máy Mac này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk 会重启并清除数据库文件，这样被删掉的条目就无法再从这台 Mac 上恢复。删除还没触及到的那部分会留在你的 iCloud 私有数据库里，并且会重新回到这台 Mac 上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk 會重新啟動並清除資料庫檔案，讓你刪除的項目無法再從這台 Mac 復原。刪除尚未觸及的部分會留在你的 iCloud 私人資料庫中，並會再次回到這台 Mac。"
          }
        }
      }
    },
    "Copymunk will restart itself to finish clearing the database file.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُعيد Copymunk تشغيل نفسه لإكمال مسح ملف قاعدة البيانات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk startet sich selbst neu, um das Leeren der Datenbankdatei abzuschließen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk se reiniciará para terminar de borrar el archivo de la base de datos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk se relancera tout seul pour terminer l’effacement du fichier de base de données."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk si riavvierà per finire di cancellare il file del database."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データベースファイルの消去を完了するため、Copymunkが自動で再起動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터베이스 파일 지우기를 완료하기 위해 Copymunk가 다시 시작됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk перезапустится, чтобы завершить очистку файла базы данных."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk จะเริ่มการทำงานใหม่เองเพื่อล้างไฟล์ฐานข้อมูลให้เสร็จสิ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk, veritabanı dosyasını temizlemeyi bitirmek için kendini yeniden başlatacak."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk sẽ tự khởi động lại để hoàn tất việc xóa sạch tệp cơ sở dữ liệu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk 会自行重启，以便把数据库文件彻底清除干净。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Copymunk 會自行重新啟動，以完成清除資料庫檔案。"
          }
        }
      }
    },
