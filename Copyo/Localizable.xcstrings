    "Mirrors your history straight to your iCloud. Deleting an entry removes it on every device.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعكس سجلك مباشرةً إلى iCloud الخاص بك. حذف عنصر يزيله من كل الأجهزة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiegelt deinen Verlauf direkt in deine iCloud. Löschst du einen Eintrag, verschwindet er auf allen Geräten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Refleja tu historial directamente en tu iCloud. Al eliminar un elemento, se elimina en todos los dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie votre historique directement dans votre iCloud. Supprimer un élément le supprime sur tous vos appareils."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴をiCloudにそのままミラーリングします。項目を削除すると、すべてのデバイスから削除されます。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçmişinizi doğrudan iCloud hesabınıza yansıtır. Bir öğeyi silmek onu tüm aygıtlardan kaldırır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直接镜像到你的 iCloud，删除会在所有设备生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "直接將歷史記錄鏡像到你的 iCloud，刪除項目會在所有裝置上生效。"
          }
        }
      }
    },
