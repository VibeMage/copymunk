    "Choose a folder that all of your Macs can read and write.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر مجلدًا يمكن لجميع أجهزة Mac لديك القراءة منه والكتابة فيه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen Ordner, den alle deine Macs lesen und beschreiben können."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una carpeta en la que todos tus Mac puedan leer y escribir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un dossier auquel tous vos Mac ont accès en lecture et en écriture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una cartella in cui tutti i tuoi Mac possano leggere e scrivere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのMacで読み書きできるフォルダを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 Mac에서 읽고 쓸 수 있는 폴더를 선택하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите папку, доступную для чтения и записи на всех Ваших компьютерах Mac."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โปรดเลือกโฟลเดอร์ที่ Mac ทุกเครื่องของคุณอ่านและเขียนได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm Mac’lerinizin okuyup yazabildiği bir klasör seçin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy chọn một thư mục mà tất cả máy Mac của bạn đều có thể đọc và ghi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择一个你的所有 Mac 都能读写的文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請選擇一個你所有 Mac 都能讀寫的資料夾。"
          }
        }
      }
    },
    "Choose a sync folder below to turn on syncing.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر مجلد مزامنة أدناه لتشغيل المزامنة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle unten einen Sync-Ordner, um die Synchronisierung zu aktivieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige abajo una carpeta de sincronización para activar la sincronización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un dossier de synchronisation ci-dessous pour activer la synchronisation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una cartella di sincronizzazione qui sotto per attivare la sincronizzazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下で同期フォルダを選択すると、同期がオンになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동기화를 켜려면 아래에서 동기화 폴더를 선택하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите ниже папку синхронизации, чтобы включить синхронизацию."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกโฟลเดอร์เชื่อมข้อมูลด้านล่างเพื่อเปิดการเชื่อมข้อมูล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eşzamanlamayı açmak için aşağıdan bir eşzamanlama klasörü seçin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn thư mục đồng bộ hóa bên dưới để bật đồng bộ hóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在下方选择同步文件夹后即可开启同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在下方選擇同步資料夾後即可開啟同步。"
          }
        }
      }
    },
