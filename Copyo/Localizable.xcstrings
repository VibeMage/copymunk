{
  "sourceLanguage": "en",
  "strings": {
    "%@ is also used by another app: pressing it triggers that app, and Copymunk may not respond. Choose a different combination.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wird auch von einer anderen App verwendet: Beim Drücken reagiert diese App, und Copymunk reagiert möglicherweise nicht. Wähle eine andere Kombination."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otra app también usa %@: al pulsar esta combinación, se activa esa app y puede que Copymunk no responda. Elige otra combinación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est aussi utilisé par une autre app : appuyer dessus déclenche cette app, et Copymunk risque de ne pas réagir. Choisissez une autre combinaison."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はほかのアプリでも使われています。押すとそのアプリが反応し、Copymunkが応答しない場合があります。別の組み合わせを選んでください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 同时被另一个 App 占用：按下时会触发那个 App，Copymunk 不一定响应，请换一个组合"
          }
        }
      }
    },
    "%@ isn’t working because another app is using it. Choose a different combination.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ funktioniert nicht, weil eine andere App die Kombination verwendet. Wähle eine andere Kombination."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no funciona porque la está usando otra app. Elige otra combinación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne fonctionne pas, car une autre app l’utilise. Choisissez une autre combinaison."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はほかのアプリが使用しているため機能していません。別の組み合わせを選んでください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 现在不起作用，它已被另一个 App 占用，请换一个组合"
          }
        }
      }
    },
    "%@ isn’t working because macOS uses it as a keyboard shortcut. Choose a different combination, or turn that shortcut off in System Settings.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ funktioniert nicht, weil macOS die Kombination als Tastaturkurzbefehl verwendet. Wähle eine andere Kombination oder deaktiviere diesen Kurzbefehl in den Systemeinstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no funciona porque macOS la usa como función rápida de teclado. Elige otra combinación o desactiva esa función rápida en Ajustes del Sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne fonctionne pas, car macOS l’utilise comme raccourci clavier. Choisissez une autre combinaison ou désactivez ce raccourci dans Réglages Système."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はmacOSのキーボードショートカットとして使われているため機能していません。別の組み合わせを選ぶか、システム設定でそのショートカットをオフにしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 现在不起作用，它已被系统快捷键占用，请换一个组合，或在系统设置里关掉那个快捷键"
          }
        }
      }
    },
