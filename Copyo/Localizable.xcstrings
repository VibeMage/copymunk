    },
    "Always on": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Immer an"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siempre activado"
          }
        },
        "fr": {
          "stringUnit": {
