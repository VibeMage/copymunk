    "Nothing was deleted. Try again, and if it keeps failing, quit Copymunk from the menu bar icon and open it again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُحذف أي شيء. حاول مرة أخرى، وإذا استمر الفشل، فأنهِ Copymunk من أيقونة شريط القائمة ثم افتحه من جديد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurde nichts gelöscht. Versuche es erneut. Wenn es weiterhin fehlschlägt, beende Copymunk über das Menüleistensymbol und öffne es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha eliminado nada. Vuelve a intentarlo y, si sigue fallando, sal de Copymunk desde el icono de la barra de menús y vuelve a abrirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’a été supprimé. Réessayez ; si l’échec persiste, quittez Copymunk depuis l’icône de la barre des menus puis relancez-le."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何も削除されませんでした。もう一度お試しください。それでも失敗する場合は、メニューバーのアイコンからCopymunkを終了して、もう一度開いてください。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir şey silinmedi. Yeniden deneyin; sorun sürerse menü çubuğu simgesinden Copymunk’tan çıkıp uygulamayı yeniden açın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有删除任何内容。请再试一次；如果一直失败，请从菜单栏图标退出 Copymunk 再重新打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有刪除任何內容。請再試一次；若持續失敗，請從選單列圖像結束 Copymunk 再重新打開。"
          }
        }
      }
    },
    "Nothing you copy in them goes into your history": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
