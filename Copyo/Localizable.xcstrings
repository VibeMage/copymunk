        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive bu Mac’te kapalı. Sistem Ayarları’nda açın veya başka bir klasör seçin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive đang tắt trên máy Mac này. Hãy bật iCloud Drive trong Cài đặt hệ thống hoặc chọn thư mục khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 没有打开 iCloud Drive。请在系统设置里打开，或者另选一个文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
