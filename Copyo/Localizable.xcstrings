    "Always copy as plain text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النسخ دائمًا كنص عادي"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Immer als reinen Text kopieren"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiar siempre como texto sin formato"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toujours copier en texte brut"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia sempre come solo testo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "常にプレーンテキストでコピー"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항상 일반 텍스트로 복사"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всегда копировать как простой текст"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คัดลอกเป็นข้อความธรรมดาเสมอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her zaman düz metin olarak kopyala"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luôn sao chép dạng văn bản thuần túy"
          }
        },
        "zh-Hans": {
