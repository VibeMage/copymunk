        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sal de Copymunk desde el icono de la barra de menús y vuelve a abrirlo. Tu nuevo ajuste de sincronización ya está guardado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
