          "stringUnit": {
            "state": "translated",
            "value": "เริ่ม Copymunk ใหม่เพื่อหยุดการเชื่อมข้อมูล iCloud หรือไม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud eşzamanlamasını durdurmak için Copymunk yeniden başlatılsın mı?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khởi động lại Copymunk để dừng đồng bộ hóa iCloud?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重启 Copymunk 以停止 iCloud 同步？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要重新啟動 Copymunk 以停止 iCloud 同步嗎？"
          }
        }
      }
    },
