    "iCloud Drive is turned off on this Mac. Turn it on in System Settings, or choose another folder.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إيقاف iCloud Drive على جهاز Mac هذا. شغّله في إعدادات النظام، أو اختر مجلدًا آخر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive ist auf diesem Mac deaktiviert. Aktiviere es in den Systemeinstellungen oder wähle einen anderen Ordner."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive está desactivado en este Mac. Actívalo en Ajustes del Sistema o elige otra carpeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive est désactivé sur ce Mac. Activez-le dans Réglages Système ou choisissez un autre dossier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacではiCloud Driveがオフになっています。システム設定でオンにするか、別のフォルダを選択してください。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive bu Mac’te kapalı. Sistem Ayarları’nda açın veya başka bir klasör seçin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 没有打开 iCloud Drive。请在系统设置里打开，或者另选一个文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台 Mac 未開啟 iCloud 雲碟。請在系統設定中開啟，或選擇其他資料夾。"
          }
        }
      }
    },
