{
  "sourceLanguage": "en",
  "strings": {
    "%@ is also used by another app: pressing it triggers that app, and Copymunk may not respond. Choose a different combination.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم تطبيق آخر %@ أيضًا: الضغط عليه يشغّل ذلك التطبيق، وقد لا يستجيب Copymunk. اختر تركيبة مختلفة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wird auch von einer anderen App verwendet: Beim Drücken reagiert diese App, und Copymunk reagiert möglicherweise nicht. Wähle eine andere Kombination."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otra app también usa %@: al pulsar esta combinación, se activa esa app y puede que Copymunk no responda. Elige otra combinación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est aussi utilisé par une autre app : appuyer dessus déclenche cette app, et Copymunk risque de ne pas réagir. Choisissez une autre combinaison."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La combinazione %@ è usata anche da un’altra app: se la premi si attiva quell’app e Copymunk potrebbe non rispondere. Scegli un’altra combinazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はほかのアプリでも使われています。押すとそのアプリが反応し、Copymunkが応答しない場合があります。別の組み合わせを選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 키는 다른 앱에서도 사용 중입니다. 누르면 해당 앱이 실행되어 Copymunk가 반응하지 않을 수 있습니다. 다른 조합을 선택하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сочетание %@ также использует другое приложение: при нажатии сработает оно, а Copymunk может не отреагировать. Выберите другое сочетание."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปอื่นใช้ %@ อยู่ด้วย เมื่อกดจะเรียกแอปนั้นขึ้นมาและ Copymunk อาจไม่ตอบสนอง โปรดเลือกปุ่มผสมอื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ başka bir uygulama tarafından da kullanılıyor: bu tuşlara bastığınızda o uygulama tetiklenir ve Copymunk yanıt vermeyebilir. Başka bir kombinasyon seçin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ cũng đang được một ứng dụng khác sử dụng: khi nhấn, ứng dụng đó sẽ phản hồi và Copymunk có thể không phản hồi. Hãy chọn một tổ hợp khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 同时被另一个 App 占用：按下时会触发那个 App，Copymunk 不一定响应，请换一个组合"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 同時被另一個 App 使用：按下時會觸發該 App，Copymunk 不一定會回應，請換一個組合"
          }
        }
      }
    },
    "%@ isn’t working because another app is using it. Choose a different combination.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يعمل %@ لأن تطبيقًا آخر يستخدمه. اختر تركيبة مختلفة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ funktioniert nicht, weil eine andere App die Kombination verwendet. Wähle eine andere Kombination."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no funciona porque la está usando otra app. Elige otra combinación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne fonctionne pas, car une autre app l’utilise. Choisissez une autre combinaison."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La combinazione %@ non funziona perché è usata da un’altra app. Scegli un’altra combinazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はほかのアプリが使用しているため機能していません。別の組み合わせを選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 키는 다른 앱에서 사용 중이므로 작동하지 않습니다. 다른 조합을 선택하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сочетание %@ не работает, так как его использует другое приложение. Выберите другое сочетание."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ใช้งานไม่ได้เนื่องจากแอปอื่นกำลังใช้อยู่ โปรดเลือกปุ่มผสมอื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ çalışmıyor, çünkü bu kombinasyonu başka bir uygulama kullanıyor. Başka bir kombinasyon seçin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ không hoạt động vì một ứng dụng khác đang sử dụng tổ hợp này. Hãy chọn một tổ hợp khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 现在不起作用，它已被另一个 App 占用，请换一个组合"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 目前無法使用，它已被另一個 App 佔用，請換一個組合"
          }
        }
      }
    },
    "%@ isn’t working because macOS uses it as a keyboard shortcut. Choose a different combination, or turn that shortcut off in System Settings.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يعمل %@ لأن macOS يستخدمه كاختصار لوحة مفاتيح. اختر تركيبة مختلفة، أو أوقف ذلك الاختصار في إعدادات النظام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ funktioniert nicht, weil macOS die Kombination als Tastaturkurzbefehl verwendet. Wähle eine andere Kombination oder deaktiviere diesen Kurzbefehl in den Systemeinstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no funciona porque macOS la usa como función rápida de teclado. Elige otra combinación o desactiva esa función rápida en Ajustes del Sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne fonctionne pas, car macOS l’utilise comme raccourci clavier. Choisissez une autre combinaison ou désactivez ce raccourci dans Réglages Système."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La combinazione %@ non funziona perché macOS la usa come abbreviazione da tastiera. Scegli un’altra combinazione o disattiva quell’abbreviazione in Impostazioni di Sistema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はmacOSのキーボードショートカットとして使われているため機能していません。別の組み合わせを選ぶか、システム設定でそのショートカットをオフにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 키는 macOS의 키보드 단축키로 사용 중이므로 작동하지 않습니다. 다른 조합을 선택하거나 시스템 설정에서 해당 단축키를 끄십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сочетание %@ не работает, так как macOS использует его как сочетание клавиш. Выберите другое сочетание или выключите это сочетание клавиш в Системных настройках."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ใช้งานไม่ได้เนื่องจาก macOS ใช้เป็นปุ่มลัดแป้นพิมพ์ โปรดเลือกปุ่มผสมอื่น หรือปิดปุ่มลัดนั้นในการตั้งค่าระบบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ çalışmıyor, çünkü macOS bu kombinasyonu klavye kısayolu olarak kullanıyor. Başka bir kombinasyon seçin veya Sistem Ayarları’nda o kısayolu kapatın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ không hoạt động vì macOS đang dùng tổ hợp này làm phím tắt bàn phím. Hãy chọn một tổ hợp khác hoặc tắt phím tắt đó trong Cài đặt hệ thống."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 现在不起作用，它已被系统快捷键占用，请换一个组合，或在系统设置里关掉那个快捷键"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 目前無法使用，它已被系統快速鍵佔用，請換一個組合，或在系統設定中關閉該快速鍵"
          }
        }
      }
    },
