    "Push notifications are unavailable on this Mac, so changes made on your other devices only arrive when Copymunk starts.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Push-Mitteilungen sind auf diesem Mac nicht verfügbar. Änderungen von deinen anderen Geräten kommen daher erst beim Start von Copymunk an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones push no están disponibles en este Mac, así que los cambios hechos en tus otros dispositivos solo llegan al abrir Copymunk."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications push ne sont pas disponibles sur ce Mac : les modifications faites sur vos autres appareils n’arrivent donc qu’au lancement de Copymunk."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacではプッシュ通知を利用できないため、ほかのデバイスでの変更はCopymunkの起動時にのみ反映されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 无法接收推送通知，其他设备上的改动只有在 Copymunk 启动时才会同步下来。"
          }
        }
      }
    },
