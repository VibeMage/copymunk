    "This combination is already used by a macOS keyboard shortcut. Restored to %@.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه التركيبة مستخدمة بالفعل كاختصار لوحة مفاتيح في macOS. تمت الاستعادة إلى %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Kombination wird bereits von einem macOS-Tastaturkurzbefehl verwendet. Zurückgesetzt auf %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta combinación ya la usa una función rápida de teclado de macOS. Se ha restablecido a %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette combinaison est déjà utilisée par un raccourci clavier de macOS. Rétablie sur %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この組み合わせはmacOSのキーボードショートカットですでに使われています。%@に戻しました。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kombinasyon zaten bir macOS klavye kısayolu tarafından kullanılıyor. Geri yüklenen kısayol: %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个组合已被系统快捷键占用，已恢复为 %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個組合已被系統快速鍵佔用，已回復為 %@"
          }
        }
      }
    },
    "This combination is already used by another app. Restored to %@.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه التركيبة يستخدمها تطبيق آخر بالفعل. تمت الاستعادة إلى %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Kombination wird bereits von einer anderen App verwendet. Zurückgesetzt auf %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta combinación ya la usa otra app. Se ha restablecido a %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette combinaison est déjà utilisée par une autre app. Rétablie sur %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この組み合わせはほかのアプリですでに使われています。%@に戻しました。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
