          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "생성되면 현재 카드가 고정됨"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текущая карточка будет закреплена в нем после создания"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การ์ดปัจจุบันจะถูกปักหมุดไว้ในนั้นเมื่อสร้างเสร็จ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oluşturulduğunda geçerli kart buna iğnelenir"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thẻ hiện tại sẽ được ghim vào đó sau khi tạo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "建好后把当前卡固定进去"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "建立後會將目前的卡片釘選進去"
          }
        }
      }
    },
    "The folder was moved or renamed, or Copymunk lost permission to it.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم نقل المجلد أو تغيير اسمه، أو فقد Copymunk إذن الوصول إليه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ordner wurde bewegt oder umbenannt, oder Copymunk hat keinen Zugriff mehr darauf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carpeta se ha movido o renombrado, o Copymunk ha perdido el permiso para acceder a ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier a été déplacé ou renommé, ou Copymunk n’y a plus accès."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cartella è stata spostata o rinominata, oppure Copymunk ha perso l’autorizzazione ad accedervi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダが移動されたか名前が変更されたか、Copymunkのアクセス権が失われました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더가 이동되었거나 이름이 변경되었거나, Copymunk의 폴더 접근 권한이 사라졌습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Папка была перемещена или переименована, либо Copymunk потерял к ней доступ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โฟลเดอร์ถูกย้ายหรือเปลี่ยนชื่อ หรือ Copymunk สูญเสียสิทธิ์เข้าถึง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klasör taşındı veya adı değiştirildi ya da Copymunk’un klasöre erişim izni kalmadı."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thư mục đã bị di chuyển hoặc đổi tên, hoặc Copymunk đã mất quyền truy cập thư mục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目录被移走、改名或授权失效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資料夾已被移動或重新命名，或 Copymunk 已失去它的存取權限。"
          }
        }
      }
    },
    "The same deletion is queued for your iCloud private database and your other Macs. Keep Copymunk open and signed in to iCloud until it finishes — Copymunk cannot tell you when that is.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عملية الحذف نفسها في قائمة الانتظار لإرسالها إلى قاعدة بياناتك الخاصة على iCloud وإلى أجهزة Mac الأخرى لديك. أبقِ Copymunk مفتوحًا وابقَ مسجّل الدخول إلى iCloud حتى تكتمل — لا يستطيع Copymunk إعلامك بموعد ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieselbe Löschung ist für deine private iCloud-Datenbank und deine anderen Macs vorgemerkt. Lass Copymunk geöffnet und bleib bei iCloud angemeldet, bis sie abgeschlossen ist – Copymunk kann dir nicht sagen, wann das ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La misma eliminación está en cola para tu base de datos privada de iCloud y tus otros Mac. Mantén Copymunk abierto y con la sesión de iCloud iniciada hasta que termine — Copymunk no puede avisarte de cuándo ocurre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La même suppression est mise en file d’attente pour votre base de données privée iCloud et vos autres Mac. Laissez Copymunk ouvert et restez connecté à iCloud jusqu’à la fin — Copymunk ne peut pas vous dire quand ce sera fait."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La stessa eliminazione è in coda per il tuo database privato iCloud e per gli altri Mac. Tieni Copymunk aperto e con l’accesso a iCloud attivo finché non è terminata: Copymunk non può dirti quando succederà."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ削除が、iCloudのプライベートデータベースとほかのMac向けにキューに追加されました。完了するまでCopymunkを開いたまま、iCloudにサインインした状態にしておいてください。いつ完了するかをCopymunkからお知らせすることはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 삭제 요청이 iCloud 개인 데이터베이스와 다른 Mac으로 전송되도록 대기 중입니다. 완료될 때까지 Copymunk를 열어 두고 iCloud에 로그인된 상태를 유지하십시오. Copymunk는 완료 시점을 알려 줄 수 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Такое же удаление поставлено в очередь для Вашей частной базы данных iCloud и других Ваших компьютеров Mac. Не закрывайте Copymunk и не выходите из iCloud, пока оно не завершится, — Copymunk не может сообщить, когда это произойдет."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การลบเดียวกันนี้อยู่ในคิวเพื่อส่งไปยังฐานข้อมูลส่วนตัวบน iCloud และ Mac เครื่องอื่นของคุณ โปรดเปิด Copymunk ไว้และลงชื่อเข้า iCloud ไว้จนกว่าจะเสร็จ ซึ่ง Copymunk ไม่สามารถแจ้งได้ว่าจะเสร็จเมื่อใด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı silme işlemi iCloud özel veritabanınız ve diğer Mac’leriniz için sıraya alındı. İşlem bitene kadar Copymunk’u açık tutun ve iCloud oturumunuzu kapatmayın — Copymunk bunun ne zaman olacağını size bildiremez."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lệnh xóa tương tự đã được xếp hàng chờ gửi đến cơ sở dữ liệu riêng tư iCloud và các máy Mac khác của bạn. Hãy để Copymunk mở và giữ đăng nhập iCloud cho đến khi hoàn tất — Copymunk không thể cho bạn biết khi nào việc đó xong."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同样的删除已经排进队列，会发往你的 iCloud 私有数据库和你的其他 Mac。请让 Copymunk 保持打开并保持 iCloud 登录状态直到发送完成——Copymunk 无法告诉你那是什么时候。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同樣的刪除已排入佇列，將傳送到你的 iCloud 私人資料庫和你的其他 Mac。請讓 Copymunk 保持打開並維持登入 iCloud，直到傳送完畢——Copymunk 無法告訴你何時完成。"
          }
        }
      }
    },
    "This Mac has synced with iCloud before. Copymunk cannot touch the iCloud copy while sync is off — set Sync to iCloud, reopen Copymunk and delete again to remove that copy too.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سبقت مزامنة جهاز Mac هذا مع iCloud. لا يستطيع Copymunk المساس بالنسخة الموجودة على iCloud ما دامت المزامنة متوقفة — اضبط «المزامنة» على iCloud، وأعد فتح Copymunk، ثم احذف مرة أخرى لإزالة تلك النسخة أيضًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Mac wurde schon einmal mit iCloud synchronisiert. Solange die Synchronisierung aus ist, kann Copymunk die iCloud-Kopie nicht antasten – stelle „Sync“ auf iCloud, öffne Copymunk erneut und lösche noch einmal, um auch diese Kopie zu entfernen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac ya se ha sincronizado con iCloud antes. Copymunk no puede tocar la copia de iCloud mientras la sincronización esté desactivada — cambia “Sincronización” a iCloud, vuelve a abrir Copymunk y elimina de nuevo para borrar también esa copia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce Mac a déjà été synchronisé avec iCloud. Copymunk ne peut pas toucher à la copie iCloud tant que la synchronisation est désactivée — réglez « Synchronisation » sur iCloud, relancez Copymunk et supprimez à nouveau pour effacer cette copie aussi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo Mac è già stato sincronizzato con iCloud in passato. Copymunk non può toccare la copia su iCloud mentre la sincronizzazione è disattivata: imposta “Sincronizzazione” su iCloud, riapri Copymunk ed elimina di nuovo per rimuovere anche quella copia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacは以前iCloudと同期したことがあります。同期がオフの間、CopymunkはiCloud上のコピーを操作できません。そのコピーも削除するには、「同期」をiCloudに設定し、Copymunkを開き直してから、もう一度削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac은 이전에 iCloud와 동기화한 적이 있습니다. 동기화가 꺼져 있는 동안에는 Copymunk가 iCloud의 사본에 접근할 수 없습니다. 해당 사본도 제거하려면 동기화를 iCloud로 설정하고 Copymunk를 다시 연 다음 한 번 더 삭제하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот Mac раньше синхронизировался с iCloud. Пока синхронизация выключена, Copymunk не может изменить копию в iCloud — выберите iCloud в разделе «Синхронизация», снова откройте Copymunk и повторите удаление, чтобы удалить и эту копию."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac เครื่องนี้เคยเชื่อมข้อมูลกับ iCloud มาก่อน Copymunk แตะต้องสำเนาบน iCloud ไม่ได้ขณะที่การเชื่อมข้อมูลปิดอยู่ หากต้องการลบสำเนานั้นด้วย ให้ตั้งค่า “เชื่อมข้อมูล” เป็น iCloud เปิด Copymunk ใหม่ แล้วลบอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac daha önce iCloud ile eşzamanlandı. Eşzamanlama kapalıyken Copymunk iCloud’daki kopyaya dokunamaz — o kopyayı da kaldırmak için “Eşzamanlama” ayarını iCloud olarak belirleyin, Copymunk’u yeniden açın ve yeniden silin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy Mac này đã từng đồng bộ hóa với iCloud. Copymunk không thể động đến bản sao trên iCloud khi đồng bộ hóa đang tắt — hãy đặt “Đồng bộ hóa” thành iCloud, mở lại Copymunk và xóa lần nữa để xóa cả bản sao đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 以前用过 iCloud 同步。同步关着的时候 Copymunk 碰不到 iCloud 上那份副本——把「同步」设为 iCloud、重新打开 Copymunk 再删一次，才能把那份也删掉。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台 Mac 先前曾與 iCloud 同步。同步關閉時，Copymunk 無法動到 iCloud 上的副本——將「同步」設為 iCloud、重新打開 Copymunk 並再刪除一次，才能將該副本一併移除。"
          }
        }
      }
    },
    "This Pinboard is empty": {
